(0053) //  Private data:
(0054) //-----------------------------------------------------------------------------
(0055) static BYTE const bufCmdOn		[] = "on";
(0056) static BYTE const bufCmdOff		[] = "off";
(0057) static BYTE const bufCmdFreq	[] = "freq";
(0058) static BYTE const bufCmdMeasImp	[] = "imp";
(0059) static BYTE const bufCmdMeasRaw	[] = "raw";
(0060) static BYTE const bufCmdScan	[] = "scan";
(0061) static BYTE const bufCmdScanRaw	[] = "scanr";
(0062) static BYTE const bufCmdScanBR	[] = "scanbr";
(0063) static BYTE const bufCmdScanV	[] = "scanv";
(0064) static BYTE const bufCmdSweep	[] = "sweep";
(0065) 
(0066) static BYTE const bufWelcome	[] = "\r\n" PRODUCT_NAME_STR " SWR Analyzer " VERSION_STR "\r\n";
(0067) static BYTE const bufCmdPrompt	[] = "\r\n>>";
(0068) static BYTE const bufWaitLink	[] = "Waiting Link";
(0069) static BYTE const bufErrCmdNotFound1[] = "\r\nCommand <";
(0070) static BYTE const bufErrCmdNotFound2[] = "> not found\r\n";
(0071) 
(0072) //-----------------------------------------------------------------------------
(0073) //  Prototypes
(0074) //-----------------------------------------------------------------------------
(0075) 
(0076) 
(0077) //-----------------------------------------------------------------------------
(0078) //  FUNCTION NAME:	PcLink
(0079) //	DESCRIPTION:	PC link routines for update measurements
(0080) //					UART Speed is VC3 / 8, e.g.
(0081) //					24MHz SysClk / 52 / 8 = 57692 (57700)
(0082) //  ARGUMENTS:		none.
(0083) //  RETURNS:		none.
(0084) //-----------------------------------------------------------------------------
(0085) void PcLink (void)
(0086) {
(0087) 	char * strPtr; 						// Parameter pointer
(0088) 	UART_CmdReset(); 					// Initialize receiver/cmd buffer
(0089) 	UART_IntCntl(UART_ENABLE_RX_INT); 	// Enable RX interrupts
(0090) 	UART_Start(UART_PARITY_NONE); 		// Enable UART
(0091) 	M8C_EnableGInt ;
(0092) 
(0093) 	// Clear the terminal screen & display welcome message
(0094)     UART_PutChar(12); UART_CPutString(bufWelcome); UART_CPutString(bufCmdPrompt);
(0095) 
(0096) 	// Brief message for LCD then main loop
(0097) 	Screen_CStrAtRowCol(1,0, bufWaitLink);
(0098) 	while(TRUE) {
(0099) 		if (KEYPAD_Get() == KBD_UP) break;
(0100) 		if(UART_bCmdCheck()) 							// Wait for command
(0101) 		{							
(0102) 			if(strPtr = UART_szGetParam())
(0103) 			{
(0104) 				Screen_CStrAtRowCol(1,0, gBlankStr_16);
(0105) 				Screen_StrAtRowCol(1,0, strPtr);
(0106)     			
(0107) 				if(!cstrcmp((const char*)bufCmdOn,(char*)strPtr)) 				{Cmd_On();}
(0108)     			else if(!cstrcmp((const char*)bufCmdOff,(char*)strPtr))			{Cmd_Off();}
(0109)     			else if(!cstrcmp((const char*)bufCmdFreq,(char*)strPtr))		{Cmd_Freq();}
(0110)     			else if(!cstrcmp((const char*)bufCmdMeasImp,(char*)strPtr))		{pcLinkPrintToSerial(CMD, SRXZ);}
(0111)     			else if(!cstrcmp((const char*)bufCmdMeasRaw,(char*)strPtr))		{pcLinkPrintToSerial(CMD, VFVRVZVA);}
(0112) 				else if(!cstrcmp((const char*)bufCmdScan,(char*)strPtr))		{pcLinkFreqScan(SCAN);}
(0113)     			else if(!cstrcmp((const char*)bufCmdScanRaw,(char*)strPtr))		{pcLinkFreqScan(SCANR);}
(0114) 				else if(!cstrcmp((const char*)bufCmdScanBR,(char*)strPtr))		{pcLinkFreqScan(SCANBR);}					
(0115) 				else if(!cstrcmp((const char*)bufCmdScanV,(char*)strPtr))		{pcLinkFreqScan(SCANV);}					
(0116) 				else{ UART_CPutString(bufErrCmdNotFound1); UART_PutString(strPtr); UART_CPutString(bufErrCmdNotFound2);}
(0117) 			}
(0118) 			UART_CmdReset(); // Reset command buffer
(0119) 			UART_CPutString(bufCmdPrompt);
(0120) 		}
(0121) 		Screen_CStrAtRowCol(0,11, "     ");
(0122) 	}
(0123) 	Set_DDS(0);
(0124) 	UART_Stop();
(0125) }
