                                        (0493) ;-----------------------------------------------------------------------------
                                        (0494) ;  FUNCTION NAME:    ComputePulseWidth
                                        (0495) ;
                                        (0496) ;  DESCRIPTION:
                                        (0497) ;     Computes the Block Erase and Block Program pulse width counts for the
                                        (0498) ;     Flash Erase and Flash Program supervisory calls.
                                        (0499) ;
                                        (0500) ;     This routine gets its data from the FlashWriteBlock data structure
                                        (0501) ;     and saves the return data in the same structure.
                                        (0502) ;
                                        (0503) ;     First, the Temperature data table is accessed via the Table Read SSC
                                        (0504) ;     function.  Then the Erase  and Program pulse width counts are computed.
                                        (0505) ;
                                        (0506) ;     Temperature table gives the slope, Y intercept, and Erase to Program pulse
                                        (0507) ;     width converion.  Two equations are given - temperatures below 0 and
                                        (0508) ;     temperatures above 0. Data is scaled to fit within specified byte range.
                                        (0509) ;
                                        (0510) ;        PW(erase) = B - M*T*2/256 and PW(program)= PW(erase)*Multiplier/64
                                        (0511) ;
                                        (0512) ;     ADJUSTMENT FOR SLIMO:
                                        (0513) ;     --------------------
                                        (0514) ;     After calculation of both the PW(erase) and PW(Program), the SLIMO bit
                                        (0515) ;     is detected. If the SLIMO bit is enabled then both programming pulses are
                                        (0516) ;     divided by TWO and incremented by one for roundoff.  This is due to the fact
                                        (0517) ;     that the CPU clock will be set for 6MHz instead of 12MHz which means that the
                                        (0518) ;     SSC EraseBlk and WriteBlk operation will take twice as long.
                                        (0519) ;
                                        (0520) ;  ARGUMENTS:
                                        (0521) ;     X points to bFlashWriteBlock calling structure.
                                        (0522) ;
                                        (0523) ;  RETURNS:
                                        (0524) ;     BYTE  bResult - return in Accumulator
                                        (0525) ;           0 = valid
                                        (0526) ;           1 = invalid revision
                                        (0527) ;
                                        (0528) ;     Erase and Program pulse widths are returned in bFlashWriteBlock calling
                                        (0529) ;     structure.
                                        (0530) ;
                                        (0531) ;  SIDE EFFECTS:
                                        (0532) ;     none.
                                        (0533) ;
                                        (0534) ;  REQUIREMENTS:
                                        (0535) ;
                                        (0536) ;     1) The calculated erase pulse width is always < 128 (does not overflow 7 bits)
                                        (0537) ;     2) The calculated write pulse width is always < 256 (does not overflow 8 bits)
                                        (0538) ;     3) If SLIMO is enabled, then this algorithm assumes the CPU clock will be set
                                        (0539) ;        for 6MHz and NOT 12MHz!
                                        (0540) ;
                                        (0541) ;     These requirements MUST be guaranteed during device calibration.
                                        (0542) ;     They are not checked.  If they are not met, the pulse width calculation will fail.
                                        (0543) ;
                                        (0544) ;  PROCEDURE:
                                        (0545) ;     1) Get the flash programming temperature table
                                        (0546) ;     2) Check the table revision number
                                        (0547) ;     3) Select the correct data set, based on temperature
                                        (0548) ;     4) Compute the Erase Pulsewidth count
                                        (0549) ;     5) Compute the Program Pulsewidth count
                                        (0550) ;     6) Save the result data
                                        (0551) ;     7) Adjust for SLIMO
                                        (0552) ;
                                        (0553) ;-----------------------------------------------------------------------------
                                        (0554) bComputePulseWidth:
                                        (0555) 
                                        (0556)    ; 1) Get the flash programming temperature table
7E70: 55 FA 03 MOV   [g_wX10+4],0x3     (0557)    mov   [bSSC_TABLE_TableId], TEMPERATURE_TABLE_ID
