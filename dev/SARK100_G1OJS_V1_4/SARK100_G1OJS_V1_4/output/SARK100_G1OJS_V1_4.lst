(0032) #include "bridge.h"
(0033) 
(0034) #include "PSoCAPI.h"
(0035) #include "glb_data.h"
(0036) #include "dds.h"
(0037) #include "timers.h"
(0038) 
(0039) 
(0040) //-----------------------------------------------------------------------------
(0041) //  Prototypes
(0042) //-----------------------------------------------------------------------------
(0043) 
(0044) 
(0045) //-----------------------------------------------------------------------------
(0046) //  FUNCTION NAME:	MeasureBrgRts
(0047) //  DESCRIPTION: Read all bridge voltages and set global ratios Vr/Vf and Vz/Va
(0048) //  NOTES:
(0049) //    - WORD with wUNITY=1000 can encode ratios from 0.001 to 65.535 
(0050) //	    which represents impedance from zero via 0.05 to 3276.75 ohms and 
(0051) //	    VSWR from 1.00:1 via 1.002:1 in 2% steps to ~8000:1 where Vr=3999 and Vf=4000 
(0052) //    - 3k ohms can be seen on open circuit at lower frequencies, so we need to 
(0053) //      cap the ratio 1000*Vz/Va at WORD_MAX, which is done in wDivide(WORD w1, WORD w2)
(0054) //    - Vr can sometimes slightly exceed Vf due to measurement error, but
(0055) //      this is capped after correction in CorrectBrgRts and the raw (uncorrected)
(0056) //      ratio is only ever seen if verbose pcLink is used in which case assume expert user 
(0057) //      and don't hide the measurement errors, but still use wDivide for WORD_MAX safety
(0058) //  ARGUMENTS: None
(0059) //  RETURNS: Nothing, but sets global variables:
(0060) //     g_xBridge.wVzVa (wUNITY x "Vz/Va")
(0061) //     g_xBridge.wVrVf (wUNITY x "Vr/Vf")
(0062) //-----------------------------------------------------------------------------
(0063) void MeasureBrgRts ( void )
(0064) {
(0065) 	DDS_Set(g_dwCurrHz);  // DDS is off by default, so turn it on to correct freq
(0066) 	//DDS_Autolevel();
(0067) 	Delay_64ths(1);	  // Bridge capacitor settling time
(0068) 	#define pos(n) (n==0)? 1:n
(0069) 	g_wBrgRts[MODZ] 		= wDivide( wRead_ADC_DDSUNCHANGED(VzPort), pos(wRead_ADC_DDSUNCHANGED(VaPort)) );
(0070) 	g_wBrgRts[MODGAMMA] 	= wDivide( wRead_ADC_DDSUNCHANGED(VrPort), pos(wRead_ADC_DDSUNCHANGED(VfPort)) );
(0071) 	DDS_Set(0); // Turn DDS off (this function isn't called from VFO mode)
(0072) 	// cap g_wBrgRts[MODGAMMA] so that g_wSwr100 won't overflow in WORD (this cap is also applied after correction)
(0073) 	if(g_wBrgRts[MODGAMMA] > VR_OVER_VF_MAX) g_wBrgRts[MODGAMMA] = VR_OVER_VF_MAX;
(0074) }
(0075) 
(0076) void DDS_Autolevel(void)
(0077) {
(0078) 	for (g_bDDS_GainStep=0; g_bDDS_GainStep<GAIN_SETTINGS_NUM; g_bDDS_GainStep++)
(0079) 	{
(0080) 		PGA_DDS_1_SetGain(g_xGainDds[g_bDDS_GainStep].bGain1);
(0081) 		PGA_DDS_2_SetGain(g_xGainDds[g_bDDS_GainStep].bGain2);
(0082) 		if ( (wRead_ADC_DDSUNCHANGED(VfPort) >= VF_REFERENCE_LEVEL) || (g_bDDS_GainStep==(GAIN_SETTINGS_NUM-1) ) ) break;
(0083) 	}
(0084) }
(0085) 
(0086) //-----------------------------------------------------------------------------
(0087) //  FUNCTION NAME:	wRead_ADC_DDSON
(0088) //  DESCRIPTION: 	Turn on DDS and read ADC, then turn DDS Off
(0089) //  ARGUMENTS: 		None
(0090) //  RETURNS: 		WORD = Vx
(0091) //-----------------------------------------------------------------------------
(0092) WORD wRead_ADC_DDSON(BYTE VxPort) {	
(0093) 	WORD wVal;
(0094) 	DDS_Set(g_dwCurrHz);  
(0095) 	wVal=wRead_ADC_DDSUNCHANGED(VxPort);
(0096) 	DDS_Set(0);
(0097) 	return wVal;
(0098) }
(0099) //-----------------------------------------------------------------------------
(0100) //  FUNCTION NAME:	wRead_ADC
(0101) //  DESCRIPTION:	Set the specified port and read the ADC
(0102) //					Note that Vf is measured at the top of the bridge, so 
(0103) //					is double that in the common definition of the input
(0104) //					divider. Hence we have to double Vr too, which is 
(0105) //					convenient because it allows doubling the gain to 
(0106) //					reflect the halved 'rail' swing of Vr (better S/N)
(0107) //  ARGUMENTS:		BYTE VxPort - which port (see #defines in glb_data.h)
(0108) //  RETURNS: 		Measured value
(0109) //-----------------------------------------------------------------------------
(0110) WORD wRead_ADC_DDSUNCHANGED(BYTE VxPort)
(0111) {
(0112) 	WORD wVal;
(0113) 	
(0114) 	AMUX4_ADC_InputSelect(VxPort);					// Select the input port needed to be read
(0115) 	if(VxPort==VrPort) PGA_ADC_SetGain(PGA_ADC_G5_33);	// double detector amp gain for Vr
(0116) 	ADCINC12_GetSamples(1);               	    	// Ask for 1 sample
(0117)     while(ADCINC12_fIsDataAvailable() == 0);    	// Wait until next reading ready  
(0118) 	wVal=(WORD)ADCINC12_iGetData()+2048;			// Take the reading
(0119)     ADCINC12_ClearFlag();                       	// Clear ADC flag  
(0120) 	if(VxPort==VrPort) PGA_ADC_SetGain(PGA_ADC_G2_67);	// set detector amp gain back to nominal
(0121)   	
(0122) 	return wVal; 	// Return the reading
(0123) }
(0124) 
(0125) //-----------------------------------------------------------------------------
(0126) //  FUNCTION NAME: 	wDivide(WORD num, WORD denom)
(0127) //  DESCRIPTION: 	Returns (num*wUNITY)/denom capped at WORD_MAX
(0128) //					Note that the capping logic also excludes divide by zero
(0129) //  ARGUMENTS:  	WORD num, WORD denom
(0130) //  RETURNS:  		(WORD)((num*wUNITY)/denom)
(0131) //-----------------------------------------------------------------------------
(0132) WORD wDivide(WORD num, WORD denom)
(0133) {
(0134) 	return (WORD)((DWORD)wUNITY*num >= (DWORD)WORD_MAX*denom)? WORD_MAX:((WORD)(((DWORD)wUNITY*num)/denom));
(0135) }
(0136) 
(0137) 
