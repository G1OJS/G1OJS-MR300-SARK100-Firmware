(0061) //-----------------------------------------------------------------------------
(0062) //  FUNCTION NAME:	SetPowerDigitalAndAnalogue
(0063) //  DESCRIPTION:	Turn on LCD, Backlight and 30MHz osc, ADC, ADC's PGAs
(0064) //					DDS, DDS's PGAs, Set DDS Gain, Set ADC PGA Gain
(0065) //					OR: if isON is false, turn all of that off
(0066) //  ARGUMENTS:		POWER_STATE pwrState
(0067) //  RETURNS:		Nothing
(0068) //-----------------------------------------------------------------------------
(0069) void SetPowerDigitalAndAnalogue(POWER_STATE pwrState)
(0070) {
(0071)     if(pwrState==PWRON)
(0072) 	{
(0073) 	  	LCD_Init(); LCD_Control(LCD_DISP_ON);
(0074) 
(0075)       	SetPowerBackLightAndOsc(PWRON);
(0076) 	 	Delay_64ths(1);
(0077) 	  	SetPowerBackLightAndOsc(PWROFF);
(0078) 	  	Delay_64ths(1);
(0079) 	  	SetPowerBackLightAndOsc(PWRON);
(0080) 	  	Delay_64ths(1);
(0081) 	
(0082)  	  	ADCINC12_Start(ADCINC12_HIGHPOWER); 
(0083) 	  	PGA_ADC_Start(PGA_ADC_HIGHPOWER);
(0084) 		PGA_ADC_SetGain(PGA_ADC_G2_67);
(0085) 		DDS_Init();
(0086) 		PGA_DDS_1_Start(PGA_DDS_1_HIGHPOWER);	
(0087) 		PGA_DDS_2_Start(PGA_DDS_2_HIGHPOWER);
(0088) 		SetDDSGain();
(0089) 	} else {
(0090)    	  	SetPowerBackLightAndOsc(PWROFF);
(0091) 	  	Set_DDS(0);
(0092) 		PGA_DDS_1_Stop();
(0093) 		PGA_DDS_2_Stop();		
(0094) 	  	ADCINC12_Stop(); 
(0095) 		PGA_ADC_Stop();
(0096) 	  	LCD_Init(); LCD_Control(LCD_DISP_OFF);
(0097) 	}
(0098) }
(0099) //-----------------------------------------------------------------------------
(0100) //  FUNCTION NAME:	SetDDSGain
(0101) //  DESCRIPTION:	Set the gain of both PGAs controlling the DDS output
(0102) //					to the setting specified by g_bDDS_GainStep and the DDS PGA
(0103) //					gain settings table
(0104) //  ARGUMENTS:		Nothing
(0105) //  RETURNS:		Nothing
(0106) //-----------------------------------------------------------------------------
(0107) void SetDDSGain(void)
(0108) {
(0109) 	PGA_DDS_1_SetGain(g_xGainDds[g_bDDS_GainStep].bGain1);
(0110) 	PGA_DDS_2_SetGain(g_xGainDds[g_bDDS_GainStep].bGain2);
(0111) }
(0112) //-----------------------------------------------------------------------------
(0113) //  FUNCTION NAME:	SetPowerBackLightAndOsc
(0114) //  DESCRIPTION:	Assert XO_EN which powers the backlight and 30MHz osc
(0115) //					OR: if isON is false, off
(0116) //  ARGUMENTS:		POWER_STATE pwrState
(0117) //  RETURNS:		Nothing
(0118) //-----------------------------------------------------------------------------
(0119) void SetPowerBackLightAndOsc(POWER_STATE pwrState)
(0120) {
(0121)     if(pwrState==PWRON) {
(0122) 		Port_2_Data_SHADE |= XO_EN_MASK;
(0123) 		XO_EN_Data_ADDR |= XO_EN_MASK;
(0124) 	}  else  {
(0125) 		XO_EN_Data_ADDR &= ~XO_EN_MASK;
(0126) 		Port_2_Data_SHADE &= ~XO_EN_MASK;
(0127) 	}
(0128) }
