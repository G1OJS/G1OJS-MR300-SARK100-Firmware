                                        (0678) ;------------------------------------------------------------------------------
                                        (0679) ;   FUNCTION NAME: FlashReadBlock
                                        (0680) ;
                                        (0681) ;   DESCRIPTION:
                                        (0682) ;   Reads a specified flash block to a buffer in RAM.
                                        (0683) ;
                                        (0684) ;   ARGUMENTS:
                                        (0685) ;   A,X -> FLASH_READ_STRUCT
                                        (0686) ;
                                        (0687) ;   RETURNS:
                                        (0688) ;   Data read is returned at specified pFlashBuffer.
                                        (0689) ;
                                        (0690) ;   SIDE EFFECTS:
                                        (0691) ;   Uses SSC storage at FBh and FDh
                                        (0692) ;
                                        (0693) ;   PROCEDURE:
                                        (0694) ;   BlockID is converted to absolute address and then ROMX command is used
                                        (0695) ;   to read the data from flash into the specified buffer.
                                        (0696) ;
                                        (0697) ;------------------------------------------------------------------------------
                                        (0698) .SECTION
                                        (0699)  FlashReadBlock:
                                        (0700) _FlashReadBlock:
                                        (0701) 
                                        (0702)    ; Preserve the SMM or LMM paging mode
7F15: 62 D0 00 MOV   REG[0xD0],0x0      (0703)    RAM_SETPAGE_CUR  0
7F18: 53 F8    MOV   [g_wX10+2],A       (0704)    mov   [bTEMP_SPACE], A     ; temporarily store the MSB of the WriteBlock structure
7F1A: 5D F7    MOV   A,REG[0xF7]        (0705)    mov   A, reg[CPU_F]        ; grab the current CPU flag register and save on stack
7F1C: 08       PUSH  A                  (0706)    push  A
7F1D: 51 F8    MOV   A,[g_wX10+2]       (0707)    mov   A, [bTEMP_SPACE]     ; restore the MSB of the WriteBlock structure
                                        (0708) 
                                        (0709)    ; Since the SSC operations all reference page 0, save and set the current ptr
                                        (0710)    ; to page 0 and the X_ptr to track the stack page.
7F1F: 70 BF    AND   F,0xBF             (0711)    RAM_PROLOGUE RAM_USE_CLASS_3
