(0024) //	PROJECT:	SARK100 SWR Analyzer
(0025) // 	FILE NAME: 	DDS.C
(0026) // 	AUTHOR:		EA4FRB - Melchor Varela
(0027) //
(0028) // 	DESCRIPTION
(0029) //
(0030) //	DDS driver
(0031) //
(0032) // 	HISTORY
(0033) //
(0034) //	NAME   		DATE		REMARKS
(0035) //
(0036) //	MVM	   		DEC 2009	Creation
