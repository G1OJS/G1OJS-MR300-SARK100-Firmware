(0127) //-----------------------------------------------------------------------------
(0128) //  FUNCTION NAME: 	Screen_Capacitance
(0129) //  DESCRIPTION:	Calculate and display capacitance
(0130) //
(0131) //           C_pF	 =	10^9/(2*PI*freq_kHz * X_ohms)
(0132) //
(0133) //           10*C_pF =	100*10^9/(2*PI*freq_kHz * 10*X_ohms)
(0134) //
(0135) //			 		 = 	10^9 / ( ((freq_Hz/1000) * 10*X_ohms) / 100 ) 
(0136) //				   		* 1000	(10*pF, 10* ohms)				
(0137) //				   		/6282
(0138) // 	ARGUMENTS:		uses global values:
(0139) //						WORD g_wX10		10 x (X in ohms)
(0140) //						WORD g_wR10		10 x (R in ohms)
(0141) //  RETURNS: none.
(0142) //-----------------------------------------------------------------------------
(0143) void Screen_Capacitance (void)
(0144) {
(0145) 	DWORD dw_pFx10;
(0146) 
(0147) 	Screen_CStrAtRowCol(0,0, gModeStr[g_bMode]);				// display top row for current mode
(0148) 	// clear bottom row
(0149) 	Screen_CStrAtRowCol(1, 0, gBlankStr_16);
(0150) 	if(g_wX10==0) {
(0151) 		Screen_CStrAtRowCol(1, 0, gZeroReactanceStr);
(0152) 	} else {
(0153) 		dw_pFx10 =  g_dwCurrHz / 1000;
(0154) 		dw_pFx10 =  ((DWORD)(dw_pFx10 * (DWORD)g_wX10)) / 100;
(0155) 		dw_pFx10 = 	(DWORD)1000000000 / dw_pFx10;
(0156) 		dw_pFx10 = 	(dw_pFx10*1000) / 6282;
(0157) 		FormatNumberRJ_Sliding(dw_pFx10,4, 1);
(0158) 		Screen_StrAtRowCol(1, 0, g_buffer16);
(0159) 		Screen_CStr("pF ");
(0160) 		FormatNumberRJ_Sliding(g_wR10,4 ,1);
(0161) 		Screen_Str(g_buffer16);
(0162) 		Screen_CStr("\xf4");
(0163) 	}
(0164) }
(0165) 
(0166) //-----------------------------------------------------------------------------
(0167) //  FUNCTION NAME: 	Screen_Inductance
(0168) //  DESCRIPTION: 	Calculate and display inductance
(0169) //  ARGUMENTS:		uses global values:
(0170) //						WORD g_wX10	10 x (X in Ohms)
(0171) //						WORD g_wR10	10 x (R in Ohms)
(0172) //
(0173) //   	L uH 	=	10^6 * X / 2*PI*freq_kHz
(0174) //   	10*L uH	=	10^6 * (X*10) / 2*PI*freq_kHz
(0175) //				= 1000
(0176) //				  * X*10
(0177) //				  / 6282
(0178) //				  * 1000
(0179) //				  / (fHz/1000)
(0180) //
(0181) //  RETURNS:  nothing
(0182) //-----------------------------------------------------------------------------
(0183) void Screen_Inductance ( void )
(0184) {
(0185) 	DWORD dwL_uH;
(0186) 	dwL_uH 		=	1000 * (DWORD)g_wX10;
(0187) 	dwL_uH		=	dwL_uH / 6282;
(0188) 	dwL_uH		=	dwL_uH * 1000;
(0189) 	dwL_uH		=	dwL_uH / ( g_dwCurrHz / 1000 );
(0190) 	
(0191) 	Screen_CStrAtRowCol(0,0, gModeStr[g_bMode]);// display top row for current mode
(0192) 	Screen_CStrAtRowCol(1, 0, gBlankStr_16);	// clear bottom row
(0193) 	FormatNumberRJ_Sliding(dwL_uH,4, 1);
(0194) 	Screen_StrAtRowCol(1, 0, g_buffer16);
(0195) 	Screen_CStr("uH ");
(0196) 	FormatNumberRJ_Sliding(g_wR10,4, 1);
(0197) 	Screen_Str(g_buffer16);
(0198) 	Screen_CStr("\xf4");
(0199) }
(0200) 
(0201) //-----------------------------------------------------------------------------
(0202) //  FUNCTION NAME: 	Screen_Power
(0203) //  DESCRIPTION: 	Display power at measurement port
(0204) //					Uses mVRMS = Vz / CAL_Vz_TO_mVRMS  for mVRMS display
(0205) //						 dBm   = 20*(Vz - CAL_Vz_TO_dBm) / (Vz + CAL_Vz_TO_dBm)
(0206) //
(0207) //1 MHz					
(0208) //		dBm(RSP1a)	Vrms_true	Vz_ADC	Vz_ADC*1000=Vrms x		n		20*(VzADC-n)/(VzADC+n)	
(0209) //		-8.8		79.9		311		3893					750		-9	
(0210) //		0.0			220.0		771		3504					750		0	
(0211) //		6.8			481.3		1747	3629					750		7	
(0212) //							
(0213) //10MHz	
(0214) //		dBm(RSP1a)	Vrms_true	Vz_ADC	Vz_ADC*1000=Vrms x		n		20*(VzADC-n)/(VzADC+n)	
(0215) //		-11.7		57.2		208		3636					750		-12	
(0216) //		-0.1		217.5		709		3260					750		-1	
(0217) //		7.2			504.0		1677	3327					750		7	
(0218) //							
(0219) //								Average	3542					750		
(0220) //										= CAL_Vz_TO_mVRMS		=CAL_Vz_TO_dBm
(0221) //
(0222) //  ARGUMENTS:		WORD: Measured Vz
(0223) //  RETURNS:  		none
(0224) //-----------------------------------------------------------------------------
(0225) 
(0226) void Screen_Power(WORD wVz)
(0227) {	// display planner ...
(0228) 	// 9999mV  +15dBm
(0229) 	// 0123456789012345
(0230) 	
(0231) 	signed char dBm;
(0232) 	Screen_CStrAtRowCol(0,0, gModeStr[g_bMode]);	// display top row for current mode
(0233) 	Screen_CStrAtRowCol(1, 0, gBlankStr_16);		// clear bottom row
(0234) 	
(0235) 	#define CAL_Vz_TO_mVRMS 	3542
(0236) 	FormatNumberRJ((INT)( ((LONG)wVz*wUNITY)/CAL_Vz_TO_mVRMS  ),4,0); 
(0237) 	Screen_StrAtRowCol(1, 0, g_buffer16);
(0238) 	Screen_CStr("mV");
(0239) 	
(0240) 	#define CAL_Vz_TO_dBm 	750
(0241) 	#define LOG_TO_dB		20
(0242) 	dBm = (signed char)( (((long)wVz-CAL_Vz_TO_dBm)*LOG_TO_dB) / (wVz+CAL_Vz_TO_dBm) ); 
(0243) 	Screen_CStrAtRowCol(1, 8, (dBm<0)? "-":"+"); 
(0244) 	FormatNumberRJ((WORD)abs(dBm),2,0); 
(0245) 	Screen_Str(g_buffer16);
(0246) 	Screen_CStr("dBm");
(0247) 	
(0248) 	Screen_CStrAtRowCol(1, 15, (g_bUP_DOWN_SelectsVFOPower)? "<":" ");
(0249) 
(0250) }
(0251) 
