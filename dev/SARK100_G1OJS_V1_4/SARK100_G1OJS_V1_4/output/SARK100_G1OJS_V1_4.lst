                                        (0732) ;    the Large Memory Model.  When necessary, it is the calling function's
                                        (0733) ;    responsibility to perserve their values across calls to fastcall16 
                                        (0734) ;    functions.
                                        (0735) ;
                                        (0736)  Boot_Counter_WriteCompareValue:
                                        (0737) _Boot_Counter_WriteCompareValue:
                                        (0738)    RAM_PROLOGUE RAM_USE_CLASS_1
7CD8: 60 22    MOV   REG[0x22],A        (0739)    mov   reg[Boot_Counter_COMPARE_LSB_REG], A
7CDA: 5B       MOV   A,X                (0740)    mov   A, X
7CDB: 60 26    MOV   REG[0x26],A        (0741)    mov   reg[Boot_Counter_COMPARE_MSB_REG], A
                                        (0742)    RAM_EPILOGUE RAM_USE_CLASS_1
7CDD: 7F       RET                      (0743)    ret
                                        (0744) 
                                        (0745) 
                                        (0746) .ENDSECTION
                                        (0747) 
                                        (0748) .SECTION
                                        (0749) ;-----------------------------------------------------------------------------
                                        (0750) ;  FUNCTION NAME: Boot_Counter_wReadCounter
                                        (0751) ;
                                        (0752) ;  DESCRIPTION:
                                        (0753) ;     Returns the value in the Count register (DR0), preserving the value in
                                        (0754) ;     the compare register (DR2). Interrupts are prevented during the transfer
                                        (0755) ;     from the Count to the Compare registers by holding the clock low in
                                        (0756) ;     the MSB PSoC block.
                                        (0757) ;-----------------------------------------------------------------------------
                                        (0758) ;
                                        (0759) ;  ARGUMENTS: None
                                        (0760) ;  RETURNS:   fastcall16 WORD wCount (value of DR0 in the X & A registers)
                                        (0761) ;  SIDE EFFECTS:
                                        (0762) ;     1) The user module is stopped momentarily and one or more counts may be missed.
                                        (0763) ;     2) The A and X registers may be modified by this or future implementations
                                        (0764) ;        of this function.  The same is true for all RAM page pointer registers in
                                        (0765) ;        the Large Memory Model.  When necessary, it is the calling function's
                                        (0766) ;        responsibility to perserve their values across calls to fastcall16 
                                        (0767) ;        functions.
                                        (0768) ;
                                        (0769)  Boot_Counter_wReadCounter:
                                        (0770) _Boot_Counter_wReadCounter:
                                        (0771)  wBoot_Counter_ReadCounter:                      ; this name deprecated
                                        (0772) _wBoot_Counter_ReadCounter:                      ; this name deprecated
                                        (0773) 
                                        (0774)    bOrigCompareValue:      EQU   0                  ; Frame offset to temp Compare store
                                        (0775)    bOrigControlReg:        EQU   2                  ; Frame offset to temp CR0     store
                                        (0776)    bOrigClockSetting:      EQU   3                  ; Frame offset to temp Input   store
                                        (0777)    wCounter:               EQU   4                  ; Frame offset to temp Count   store
                                        (0778)    STACK_FRAME_SIZE:       EQU   6                  ; max stack frame size is 6 bytes
                                        (0779) 
                                        (0780)    RAM_PROLOGUE RAM_USE_CLASS_2
7CDE: 4F       MOV   X,SP               (0781)    mov   X, SP                                      ; X <-  stack frame pointer
7CDF: 5D 26    MOV   A,REG[0x26]        (0782)    mov   A, reg[Boot_Counter_COMPARE_MSB_REG]    ; Save the Compare register on the stack
7CE1: 08       PUSH  A                  (0783)    push  A                                          ;
7CE2: 5D 22    MOV   A,REG[0x22]        (0784)    mov   A, reg[Boot_Counter_COMPARE_LSB_REG]    ;
7CE4: 08       PUSH  A                  (0785)    push  A                                          ;   -stack frame now 2 bytes-
7CE5: 5D 23    MOV   A,REG[0x23]        (0786)    mov   A, reg[Boot_Counter_CONTROL_LSB_REG]    ; Save CR0 (running or stopped state)
7CE7: 08       PUSH  A                  (0787)    push  A                                          ;   -stack frame now 3 bytes-
7CE8: 41 23 FE AND   REG[0x23],0xFE     (0788)    Boot_Counter_Stop_M                           ; Disable (stop) the Counter if running
7CEB: 71 10    OR    F,0x10             (0789)    M8C_SetBank1                                     ;
7CED: 5D 21    MOV   A,REG[0x21]        (0790)    mov   A, reg[Boot_Counter_INPUT_LSB_REG]      ; save the LSB clock input setting
7CEF: 08       PUSH  A                  (0791)    push  A                                          ;   on the stack (now 4 bytes) and ...
                                        (0792)                                                     ;   hold the clock low:
7CF0: 62 21 00 MOV   REG[0x21],0x0      (0793)    mov   reg[Boot_Counter_INPUT_LSB_REG], INPUT_REG_NULL
7CF3: 70 EF    AND   F,0xEF             (0794)    M8C_SetBank0                                     ; Extract the Count via DR2 register
7CF5: 5D 24    MOV   A,REG[0x24]        (0795)    mov   A, reg[Boot_Counter_COUNTER_MSB_REG]    ; DR2 <- DR0 (in the MSB block)
7CF7: 5D 26    MOV   A,REG[0x26]        (0796)    mov   A, reg[Boot_Counter_COMPARE_MSB_REG]    ; Stash the Count MSB on the stack
7CF9: 08       PUSH  A                  (0797)    push  A                                          ;   -stack frame is now 5 bytes
7CFA: 5D 20    MOV   A,REG[0x20]        (0798)    mov   A, reg[Boot_Counter_COUNTER_LSB_REG]    ; DR2 <- DR0 (in the LSB block)
7CFC: 5D 22    MOV   A,REG[0x22]        (0799)    mov   A, reg[Boot_Counter_COMPARE_LSB_REG]    ; Stash the Count LSB on the stack
7CFE: 08       PUSH  A                  (0800)    push  A                                          ;   -stack frame is now 6 bytes-
7CFF: 52 00    MOV   A,[X+0]            (0801)    mov   A, [X+bOrigCompareValue]                   ; Restore the Compare MSB register
7D01: 60 26    MOV   REG[0x26],A        (0802)    mov   reg[Boot_Counter_COMPARE_MSB_REG], A    ;
7D03: 52 01    MOV   A,[X+1]            (0803)    mov   A, [X+bOrigCompareValue+1]                 ; Restore the Compare LSB register
7D05: 60 22    MOV   REG[0x22],A        (0804)    mov   reg[Boot_Counter_COMPARE_LSB_REG], A    ;
7D07: 71 10    OR    F,0x10             (0805)    M8C_SetBank1                                     ; ---Restore the counter operation
7D09: 52 03    MOV   A,[X+3]            (0806)    mov   A, [X+bOrigClockSetting]                   ; Grab the LSB clock setting...
7D0B: 60 21    MOV   REG[0x21],A        (0807)    mov   reg[Boot_Counter_INPUT_LSB_REG], A      ;   and restore it
7D0D: 70 EF    AND   F,0xEF             (0808)    M8C_SetBank0                                     ; Now re-enable (start) the counter
7D0F: 52 02    MOV   A,[X+2]            (0809)    mov   A, [X+bOrigControlReg]                     ;   if it was running when
7D11: 60 23    MOV   REG[0x23],A        (0810)    mov   reg[Boot_Counter_CONTROL_LSB_REG], A    ;   this function was first called
7D13: 18       POP   A                  (0811)    pop   A                                          ; Setup the return value
7D14: 20       POP   X                  (0812)    pop   X                                          ;
7D15: 38 FC    ADD   SP,0xFC            (0813)    ADD   SP, -(STACK_FRAME_SIZE-2)                  ; Zap remainder of stack frame
7D17: 70 3F    AND   F,0x3F             
7D19: 71 C0    OR    F,0xC0             (0814)    RAM_EPILOGUE RAM_USE_CLASS_2
7D1B: 7F       RET                      (0815)    ret
(0816) 
(0817) .ENDSECTION
