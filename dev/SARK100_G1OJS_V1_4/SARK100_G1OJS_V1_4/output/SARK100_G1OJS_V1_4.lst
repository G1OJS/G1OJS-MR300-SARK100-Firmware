                                        (0132) ;              pairs. Terminate on address=0xFF.
                                        (0133) ;
                                        (0134) ;  INPUTS:  [A,X] points to the table to be loaded
                                        (0135) ;           Flag Register Carry bit encodes the Register Bank
                                        (0136) ;           (Carry=0 => Bank 0; Carry=1 => Bank 1)
                                        (0137) ;
                                        (0138) ;  RETURNS: nothing.
                                        (0139) ;
                                        (0140) ;  STACK FRAME:  X-4 I/O Bank 0/1 indicator
                                        (0141) ;                X-3 Temporary store for register address
                                        (0142) ;                X-2 LSB of config table address
                                        (0143) ;                X-1 MSB of config table address
                                        (0144) ;
                                        (0145) LoadConfig:
                                        (0146)     RAM_PROLOGUE RAM_USE_CLASS_2
7AE3: 38 02    ADD   SP,0x2             (0147)     add     SP, 2                   ; Set up local vars
7AE5: 10       PUSH  X                  (0148)     push    X                       ; Save config table address on stack
7AE6: 08       PUSH  A                  (0149)     push    A
7AE7: 4F       MOV   X,SP               (0150)     mov     X, SP
7AE8: 56 FC 00 MOV   [X-4],0x0          (0151)     mov     [X-4], 0                ; Set default Destination to Bank 0
7AEB: D0 04    JNC   0x7AF0             (0152)     jnc     .BankSelectSaved        ; Carry says Bank 0 is OK
7AED: 56 FC 01 MOV   [X-4],0x1          (0153)     mov     [X-4], 1                ; No Carry: default to Bank 1
                                        (0154) .BankSelectSaved:
7AF0: 18       POP   A                  (0155)     pop     A
7AF1: 20       POP   X                  (0156)     pop     X
                                        (0157) 
                                        (0158) LoadConfigLp:
7AF2: 70 EF    AND   F,0xEF             (0159)     M8C_SetBank0                    ; Switch to bank 0
7AF4: 62 E3 00 MOV   REG[0xE3],0x0      (0160)     M8C_ClearWDT                    ; Clear the watchdog for long inits
7AF7: 10       PUSH  X                  (0161)     push    X                       ; Preserve the config table address
7AF8: 08       PUSH  A                  (0162)     push    A
7AF9: 28       ROMX                     (0163)     romx                            ; Load register address from table
7AFA: 39 FF    CMP   A,0xFF             (0164)     cmp     A, END_CONFIG_TABLE     ; End of table?
7AFC: A0 1F    JZ    0x7B1C             (0165)     jz      EndLoadConfig           ;   Yes, go wrap it up
7AFE: 4F       MOV   X,SP               (0166)     mov     X, SP                   ;
7AFF: 48 FC 01 TST   [X-4],0x1          (0167)     tst     [X-4], 1                ; Loading IO Bank 1?
7B02: A0 03    JZ    0x7B06             (0168)     jz      .IOBankNowSet           ;    No, Bank 0 is fine
7B04: 71 10    OR    F,0x10             (0169)     M8C_SetBank1                    ;   Yes, switch to Bank 1
                                        (0170) .IOBankNowSet:
7B06: 54 FD    MOV   [X-3],A            (0171)     mov     [X-3], A                ; Stash the register address
7B08: 18       POP   A                  (0172)     pop     A                       ; Retrieve the table address
7B09: 20       POP   X                  (0173)     pop     X
7B0A: 75       INC   X                  (0174)     inc     X                       ; Advance to the data byte
7B0B: 09 00    ADC   A,0x0              (0175)     adc     A, 0
7B0D: 10       PUSH  X                  (0176)     push    X                       ; Save the config table address again
7B0E: 08       PUSH  A                  (0177)     push    A
7B0F: 28       ROMX                     (0178)     romx                            ; load config data from the table
7B10: 4F       MOV   X,SP               (0179)     mov     X, SP                   ; retrieve the register address
7B11: 59 FD    MOV   X,[X-3]            (0180)     mov     X, [X-3]
7B13: 61 00    MOV   REG[X+0x0],A       (0181)     mov     reg[X], A               ; Configure the register
7B15: 18       POP   A                  (0182)     pop     A                       ; retrieve the table address
7B16: 20       POP   X                  (0183)     pop     X
7B17: 75       INC   X                  (0184)     inc     X                       ; advance to next table entry
7B18: 09 00    ADC   A,0x0              (0185)     adc     A, 0
7B1A: 8F D7    JMP   0x7AF2             (0186)     jmp     LoadConfigLp            ; loop to configure another register
                                        (0187) EndLoadConfig:
7B1C: 38 FC    ADD   SP,0xFC            (0188)     add     SP, -4
7B1E: 70 3F    AND   F,0x3F             
7B20: 71 C0    OR    F,0xC0             (0189)     RAM_EPILOGUE RAM_USE_CLASS_2
7B22: 7F       RET                      (0190)     ret
