(0055) 
(0056) 
(0057) //-----------------------------------------------------------------------------
(0058) //  FUNCTION NAME:	Do_VSWR_Scan
(0059) //  DESCRIPTION:  	Scan within band limits to find minimum VSWR that is also below SWR_BW_THRESH
(0060) //					If found, scan up and down (including beyond band limits) to
(0061) //					find SWR bandwidth at SWR_BW_THRESH
(0062) //  ARGUMENTS:		none
(0063) //  RETURNS:		Nothing
(0064) //-----------------------------------------------------------------------------
(0065) void Do_VSWR_Scan (void)
(0066) {
(0067) 	#define COARSE_STEP_Hz 51000
(0068) 	#define FINE_STEP_Hz 1000
(0069) 
(0070) 	DWORD dwEntryFreqHz=g_dwCurrHz;
(0071) 	DWORD dwMinSWRHz;
(0072) 	DWORD dwHzLow;
(0073) 	DWORD dwHzHigh;
(0074) 
(0075) 	Screen_Clear();
(0076) 	Screen_HideCursor();
(0077) 
(0078) 	// STEP 1: scan the whole band for best minimum Vr (fast)
(0079) 	// coarse scan
(0080) 	Screen_CStrAtRowCol(0, 0, gScanCoarseStr);
(0081) 	g_dwCurrHz = (DWORD)BAND_FREQ_ToHz*g_wBandBoundaries[g_bBandIndex];
(0082) 	findGlobalMinimum(SCANPARAM_Vruc, (DWORD)BAND_FREQ_ToHz*g_wBandBoundaries[g_bBandIndex+1], COARSE_STEP_Hz);
(0083) 	dwMinSWRHz = g_dwCurrHz;
(0084) 	Morse_Dit(); 
(0085) 	Screen_Frequency(Display_Hz); 
(0086) 	
(0087) 	// fine scan around coarse minimum
(0088) 	Screen_CStrAtRowCol(1, 0, gScanFineStr);
(0089) 	g_dwCurrHz -= COARSE_STEP_Hz;	// reverse one step
(0090) 	findGlobalMinimum(SCANPARAM_SWR, g_dwCurrHz+(DWORD)2*COARSE_STEP_Hz, FINE_STEP_Hz);
(0091) 	dwMinSWRHz = g_dwCurrHz;
(0092) 	Morse_Dit(); 
(0093) 	Screen_Frequency(Display_Hz); 
(0094) 		
(0095) 	if(g_wSwr100 < SWR_BW_THRESH) { 
(0096) 		// STEP 2: search downwards and upwards from the global minimum to find the bandwidth,
(0097) 		// display the bandwidth and return with global variables set to display full measurement results at match frequency
(0098) 		Screen_CStrAtRowCol(0, 0, gScanFineStr);
(0099) 		Screen_CStrAtRowCol(1, 0, gScanThreshStr);
(0100) 
(0101) 		findSWRThreshold(SCANDIRECTION_DOWN, FREQ_MIN_Hz, COARSE_STEP_Hz);	
(0102) 		g_dwCurrHz 	= g_dwCurrHz + COARSE_STEP_Hz;	// reverse one step
(0103) 		findSWRThreshold(SCANDIRECTION_DOWN, g_dwCurrHz - COARSE_STEP_Hz, FINE_STEP_Hz);	
(0104) 		dwHzLow=g_dwCurrHz;
(0105) 	
(0106) 		g_dwCurrHz=dwMinSWRHz;	// set freq to match freq and scan up to SWR>threshold
(0107) 		findSWRThreshold(SCANDIRECTION_UP, FREQ_MAX_Hz, COARSE_STEP_Hz);	
(0108) 		g_dwCurrHz 	= g_dwCurrHz - COARSE_STEP_Hz;	// reverse one step
(0109) 		findSWRThreshold(SCANDIRECTION_UP, g_dwCurrHz + COARSE_STEP_Hz, FINE_STEP_Hz);	
(0110) 		dwHzHigh=g_dwCurrHz;
(0111) 	
(0112) 		// Set g_dwCurrHz to min swr freq, measure and display results (live SWR and Frequency plus BW in bottom row) and wait for keypress
(0113) 		Screen_Clear();
(0114) 		g_dwCurrHz=dwMinSWRHz;
(0115) 		Screen_Frequency(Display_Hz); 
(0116) 		MeasureCorrectCalc();
(0117) 		Screen_SRXZ(); 
(0118) 		Screen_CStrAtRowCol(1, 0, gBlankStr_16);
(0119) 		FormatNumberRJ(dwHzLow /1000, 5, 0); Screen_StrAtRowCol(1, 0, g_buffer16);
(0120) 		FormatNumberRJ(dwHzHigh /1000, 5, 0); Screen_StrAtRowCol(1, 8, g_buffer16);
(0121) 	
(0122) 		KEYPAD_WaitKey(TIME_WAIT_KEY_S);
(0123) 	}
(0124) 	
(0125) 	Screen_Clear();
(0126) 	g_dwCurrHz = dwMinSWRHz;
(0127) 
(0128) }
(0129) 
(0130) //-----------------------------------------------------------------------------
(0131) //  FUNCTION NAME:	Do_LineLength_Scan
(0132) //  DESCRIPTION:  	Scanning routine
(0133) //  ARGUMENTS:		none
(0134) //  RETURNS:		Nothing
(0135) //-----------------------------------------------------------------------------
(0136) void Do_LineLength_Scan (void)
(0137) {
(0138) 	#define STEPHZ 233000
(0139) 	BYTE 	bMinCount;
(0140) 	WORD 	wLastMinFreqkHz;
(0141) 	DWORD 	dwEntryFreqHz=g_dwCurrHz;
(0142) 	
(0143) 	do { // this loop gives opportunity to repeat the whole process without going through menus again
(0144) 
(0145)   		Screen_Clear();
(0146) 		Screen_CStrAtRowCol(0, 0, gMinimaStr);
(0147) 		Screen_HideCursor();
(0148) 
(0149) 		// scan upwards from device min freq and stop on each minimum of *either* Vz or Va and record frequency
(0150) 		g_dwCurrHz = FREQ_MIN_Hz;
(0151) 		bMinCount=0;
(0152) 		do {
(0153) 			if(findNextGoodNotch(SCANPARAM_VzucORVauc, FREQ_MAX_Hz, STEPHZ))	{
(0154) 				Morse_Dit();
(0155) 				wLastMinFreqkHz=g_dwCurrHz/1000;
(0156) 				bMinCount++;
(0157) 				Screen_Frequency(Display_kHz);
(0158) 			}
(0159) 			g_dwCurrHz += STEPHZ*2; // start the next min search above the current minimum
(0160) 
(0161) 		} while (g_dwCurrHz <= FREQ_MAX_Hz) ;
(0162) 		
(0163) 		Screen_CableLength(    ( (DWORD)75000*(DWORD)g_bVF[g_xConf.bVF]*(DWORD)bMinCount ) / wLastMinFreqkHz  );
(0164) 		Morse_K();
(0165) 		
(0166) 		// opportunity to repeat the whole process without going through menus again (press any key but UP)
(0167) 		if( KEYPAD_WaitKey(TIME_WAIT_KEY_S) == KBD_UP ) break;		
(0168) 	} while (TRUE);
(0169) 	g_dwCurrHz = dwEntryFreqHz;
(0170) }	
(0171) 
(0172) 
(0173) //-----------------------------------------------------------------------------
(0174) //  FUNCTION NAME:	findGlobalMinimum
(0175) //  DESCRIPTION:  	Scan up in frequency and stop at dwFreqLimitHz
(0176) //					Return with g_dwCurrHz set to frequency of lowest value of specified parameter
(0177) //
(0178) //  ARGUMENTS:		SCAN_SCANPARAM 		= SCANPARAM_SWR | SCANPARAM_Vruc | SCANPARAM_Vzuc | SCANPARAM_Vauc | SCANPARAM_VzucORVauc
(0179) //										NOTE: scanning on a single voltage gives a speed increase of approx 3:1 at the expense of using 
(0180) //										the uncalibrated proxy
(0181) //					WORD bStepStepHz	-> scan step in Hz
(0182) //
(0183) //  RETURNS:		nothing
(0184) static void findGlobalMinimum(SCAN_SCANPARAM xScanParam, DWORD dwFreqLimitHz, DWORD dwStepHz)
(0185) {
(0186) 	
(0187) 	DWORD 	dwEntryFreqHz=g_dwCurrHz;
(0188) 	WORD	wParam;
(0189) 	WORD	wParamGlobalMin=WORD_MAX;
(0190) 	DWORD	dwMinParamHz;
(0191) 	
(0192) 	g_dwCurrHz -= dwStepHz; // reverse so that we have a delta for the first frequency
(0193) 	
(0194) 	do {
(0195) 		Set_DDS(g_dwCurrHz);
(0196) 		if(xScanParam == SCANPARAM_VzucORVauc) {
(0197) 			#define min(a, b) ((a<b)? a:b)
(0198) 			wParam=min(wRead_ADC_DDSUNCHANGED(VaPort), wRead_ADC_DDSUNCHANGED(VzPort));
(0199) 		} 
(0200) 		if(xScanParam == SCANPARAM_Vruc){
(0201) 			wParam = wRead_ADC_DDSUNCHANGED(VrPort);
(0202) 		}
(0203) 		if(xScanParam == SCANPARAM_SWR){
(0204) 			MeasureCorrectCalc();
(0205) 			wParam = g_wSwr100;			
(0206) 		}	
(0207) 		if(wParam < wParamGlobalMin) {
(0208) 			dwMinParamHz    = g_dwCurrHz;
(0209) 			wParamGlobalMin = wParam;
(0210) 		}
(0211) 		g_dwCurrHz += dwStepHz;	
(0212) 	} while ( g_dwCurrHz <= dwFreqLimitHz ) ;
(0213) 	
(0214) 	g_dwCurrHz=dwMinParamHz;
(0215) }
(0216) 
(0217) 
(0218) 
(0219) //-----------------------------------------------------------------------------
(0220) //  FUNCTION NAME:	findNextGoodNotch
(0221) //  DESCRIPTION:  	Scan up in frequency and stop as specified by 
(0222) //					arguments leaving final frequency and measurement in global measurement variables
(0223) //					In all cases, a full measurement and calculation is done prior to return.
(0224) //					The final frequency is that of the condition that triggered the return: (lowest) minimum or the band edge or global limit
(0225) //					Frequency and impedance etc is displayed, but only if SCAN_SCANPARAM == SCANPARAM_SWR
(0226) //					Currently, searching for maxima is not coded.
(0227) //
(0228) //  ARGUMENTS:		SCAN_SCANPARAM 		= SCANPARAM_SWR | SCANPARAM_Vruc | SCANPARAM_Vzuc | SCANPARAM_Vauc | SCANPARAM_VzucORVauc
(0229) //										-> parameter to trigger return TRUE 
(0230) //										NOTE: scanning on a single voltage gives a speed increase of approx 3:1 at the expense of using 
(0231) //										the uncalibrated proxy
(0232) //					WORD bStepStepHz	-> scan step in Hz
(0233) //
(0234) //  RETURNS:		TRUE if minimum found before wFreqLimitHz, otherwise FALSE
(0235) static BYTE findNextGoodNotch(SCAN_SCANPARAM xScanParam, DWORD dwFreqLimitHz, DWORD dwStepHz)
(0236) {
(0237) 	#define HISTLEN 8
(0238) 	#define HISTPAT0 240
(0239) 	#define HISTPAT1 242
(0240) 	#define HISTPAT2 184
(0241) 	
(0242) 	//#define DEBUG true
(0243) 	
(0244) 	DWORD 	dwEntryFreqHz=g_dwCurrHz;
(0245) 	WORD	wParam;
(0246) 	WORD	wParamPrev=WORD_MAX;
(0247) 	BYTE 	bDeltaHist;
(0248) 
(0249) 	#ifdef DEBUG 
(0250) 		UART_CmdReset(); 					// Initialize receiver/cmd buffer
(0251) 		UART_IntCntl(UART_ENABLE_RX_INT); 	// Enable RX interrupts
(0252) 		UART_Start(UART_PARITY_NONE); 		// Enable UART
(0253) 		M8C_EnableGInt ;
(0254) 		UART_PutCRLF();UART_PutCRLF();UART_PutCRLF();UART_PutCRLF();UART_PutCRLF();UART_PutCRLF();UART_PutCRLF();UART_PutCRLF();
(0255) 	#endif
(0256) 	
(0257) 	if(dwStepHz == 0) return FALSE;
(0258) 	
(0259) 	g_dwCurrHz -= dwStepHz*(HISTLEN/2-1); // reverse so that the history buffer can gather data before the start frequency
(0260) 	bDeltaHist=0;
(0261) 	
(0262) 	do {
(0263) 		Set_DDS(g_dwCurrHz);
(0264) 		if(xScanParam == SCANPARAM_VzucORVauc) {
(0265) 			#define min(a, b) ((a<b)? a:b)
(0266) 			wParam=min(wRead_ADC_DDSUNCHANGED(VaPort), wRead_ADC_DDSUNCHANGED(VzPort));
(0267) 		} 
(0268) 		if(xScanParam == SCANPARAM_Vruc){
(0269) 			wParam = wRead_ADC_DDSUNCHANGED(VrPort);
(0270) 		}
(0271) 		if(xScanParam == SCANPARAM_SWR){
(0272) 			MeasureCorrectCalc();
(0273) 			wParam = g_wSwr100;			
(0274) 		}	
(0275) 		bDeltaHist <<= 1;
(0276) 		bDeltaHist |= (wParamPrev >= wParam);
(0277) 		bDeltaHist &= (1 << HISTLEN) - 1;  
(0278) 		wParamPrev = wParam;
(0279) 		
(0280) 		#ifdef DEBUG
(0281) 			ultoa(g_buffer16, g_dwCurrHz ,10); UART_PutString(g_buffer16); UART_PutChar(',');
(0282) 			ultoa(g_buffer16, wParam ,10); UART_PutString(g_buffer16); UART_PutChar(',');
(0283) 			ultoa(g_buffer16, bDeltaHist ,10); UART_PutString(g_buffer16);
(0284) 			UART_PutCRLF();
(0285) 		#endif
(0286) 		
(0287) 		if((bDeltaHist == HISTPAT0) || (bDeltaHist == HISTPAT1) || (bDeltaHist == HISTPAT2)) 	{
(0288) 			g_dwCurrHz -= dwStepHz*(HISTLEN/2); // reverse to the min of the search pattern
(0289) 			MeasureCorrectCalc();
(0290) 			return TRUE;
(0291) 		}
(0292) 		g_dwCurrHz += dwStepHz;	
(0293) 	} while ( g_dwCurrHz <= dwFreqLimitHz ) ;
(0294) 	
(0295) 	g_dwCurrHz=dwEntryFreqHz;
(0296) 	return FALSE;
(0297) }
(0298) 
(0299) //-----------------------------------------------------------------------------
(0300) //  FUNCTION NAME:	findSWRThreshold
(0301) //  DESCRIPTION:  	Scan up or down in frequency and stop at SWR Threshold 
(0302) //	ARGUMENTS:		SCAN_DIRECTION		= SCANDIRECTION_UP | SCANDIRECTION_DOWN		-> which way to scan
(0303) //					WORD wStepStepHz	-> scan step in Hz
(0304) //  RETURNS:		nothing
(0305) //-----------------------------------------------------------------------------
(0306) static void findSWRThreshold(SCAN_DIRECTION xScanDirection, DWORD dwFreqLimitHz, DWORD dwStepHz)
(0307) {
(0308) 	do {
(0309) 		Set_DDS(g_dwCurrHz);
(0310) 		MeasureCorrectCalc();
(0311) 		if(xScanDirection == SCANDIRECTION_UP) {g_dwCurrHz += dwStepHz;} else {g_dwCurrHz -= dwStepHz;} 
(0312) 	} while ( (g_wSwr100 < SWR_BW_THRESH) && ( (xScanDirection == SCANDIRECTION_UP)? (g_dwCurrHz <= dwFreqLimitHz):(g_dwCurrHz >= dwFreqLimitHz))  ) ;
(0313) }
