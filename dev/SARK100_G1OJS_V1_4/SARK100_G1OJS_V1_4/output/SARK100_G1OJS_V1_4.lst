(0094) void Cmd_Freq (void)
(0095) {
(0096) 	DWORD dwfreqRequest = getFreqArg(); 
(0097) 	if (dwfreqRequest >= FREQ_MIN_Hz && dwfreqRequest <= FREQ_MAX_Hz) { 
(0098) 		g_dwCurrHz=dwfreqRequest;
(0099) 		UART_CPutString(bufOk);
(0100) 	} else {
(0101) 		UART_CPutString(bufErrInvalidFreq);
(0102) 	}
(0103) }
(0104) //-----------------------------------------------------------------------------
(0105) //  FUNCTION NAME:	pcLinkPrintToSerial
(0106) //  DESCRIPTION: 	Print out all four bridge voltages and/or SWR,R,X,Z
(0107) //					depending on PRINT_WHAT
(0108) //					NOTE that individual voltages are no longer used in the bulk
(0109) //					of the calculations (converted to ratios just after measurement)
(0110) //					but 4 values need to be provided for compatibility with 
(0111) //					companion software that expects them via Cmd_Raw
(0112) //					Hence, measure Vf and Vr again (uncorrected) and print out
(0113) //					Vf_uncorrected, Vf_uncorrected x (Vr/Vf)_corrected, 
(0114) //					Va_uncorrected x (Vz/Va)_corrected, Va_uncorrected
(0115) //  ARGUMENTS:		MEASMODE = CMD | SCANNING
(0116) //						CMD - called directly from pclink, likely 3rd party software
(0117) //						SCANNING - called from pcLinkFreqScan & using averaging
(0118) //					PRINT_WHAT = VRVFVZVA | SRXZ | COMBI
(0119) //
(0120) // 	RETURNS:	 
(0121) //
(0122) //	- if PRINT_WHAT == VRVFVZVA		(this emulates the old Cmd_Raw)
(0123) //		Response: corrected voltages  Vf, 'Vr' = (Vr/Vf)*Vf, 
(0124) //									  'Vz'     = (Vz/Va)*Va, Va
(0125) //
(0126) //  	Example: 4000000,165000,31800,1000000 
(0127) //
(0128) //	- if PRINT_WHAT == SRXZ			(this emulates the old Cmd_Imp)
(0129) //		Response: corrected parameters {SWR},{R},{X},{Z}
(0130) //  	Example: 1.05,52,10,51 
(0131) //
(0132) //  NOTE: used by some third party software. The expected format is as the example above
(0133) //-----------------------------------------------------------------------------
(0134) 
(0135) void pcLinkPrintToSerial (MEASMODE mMode, PRINT_WHAT pwPrintWhat)
(0136) {
(0137) 	WORD wVf;
(0138) 	WORD wVa;
(0139) 	// TODO is it important to respect the original DDS condition on entry? 
(0140) 	// if so, how to detect DDS on or off easily ...
(0141) 	
(0142) 	// if scanning, use ratios set by scan routine
(0143) 	// if not, get new ones now & note CMD measurement is always corrected
(0144) 	if(mMode == CMD) MeasureCorrectCalc(); 
(0145) 
(0146) 	if(pwPrintWhat == VFVRVZVA){	
(0147) 		wVf=wRead_ADC_DDSON(VfPort);
(0148) 		wVa=wRead_ADC_DDSON(VaPort);
(0149) 		PrintWdToSerial(wVf ,0, bThousandCommaStr);  
(0150) 		PrintWdToSerial(  ((DWORD)wVf*(DWORD)g_wBrgRts[MODGAMMA]) / wUNITY ,0, bThousandCommaStr);
(0151) 		PrintWdToSerial(  ((DWORD)wVa*(DWORD)g_wBrgRts[MODZ])     / wUNITY ,0, bThousandCommaStr);
(0152) 		PrintWdToSerial(wVa ,0, bThousandStr);
(0153) 	}
(0154) 		
(0155) 	if(pwPrintWhat == SRXZ){	
(0156) 		// Use 1 Ohm resolution on R,X,Z unless mMode=SCANBR, then use 0.1 Ohm resolution 
(0157) 		PrintWdToSerial(g_wSwr100, 											      2, 	bCommaStr);	
(0158) 		PrintWdToSerial((mMode==SCANBR)? g_wR10:((g_wR10+5)/10), (mMode==SCANBR)? 1:0,	bCommaStr);
(0159) 		PrintWdToSerial((mMode==SCANBR)? g_wX10:((g_wX10+5)/10), (mMode==SCANBR)? 1:0,	bCommaStr);
(0160) 		PrintWdToSerial((mMode==SCANBR)? g_wZ10:((g_wZ10+5)/10), (mMode==SCANBR)? 1:0,	"");
(0161) 	}
(0162) 	
(0163) }
(0164) //-----------------------------------------------------------------------------
(0165) //  FUNCTION NAME:	pcLinkFreqScan
(0166) //  DESCRIPTION:	Scan through frequencies specified and call appropriate 
(0167) //					Print_XXX routine to display requested outputs
(0168) //  ARGUMENTS:    	PRINT_WHAT = SRXZ | VRVFVZVA | COMBI
(0169) //  RETURNS:		none.
(0170) //-----------------------------------------------------------------------------
(0171) void pcLinkFreqScan(MEASMODE mMode)
(0172) {
(0173) 	DWORD dwStartFreqHz;
(0174) 	DWORD dwEndFreqHz;
(0175) 	DWORD dwStepFreqHz;
(0176) 	DWORD dwOffsetHz;
(0177) 	DWORD dwCurrHz_scan;
(0178) 	
(0179) 	do
(0180) 	{
(0181) 		// Get start, end and step frequencies
(0182) 		dwStartFreqHz = getFreqArg(); if(dwStartFreqHz == -1) break;
(0183) 		dwEndFreqHz	= getFreqArg(); if(dwEndFreqHz   == -1) break;
(0184) 		dwStepFreqHz	= getFreqArg(); if(dwStepFreqHz  == -1) break;			
(0185) 
(0186) 		// Get filter settings. Let weight range from 1 to 255.
(0187) 		#define min(a,b) ((a)>(b))? (b):(a)
(0188) 		bWeight  = min(255, ((DWORD)100000*g_bFltWd100kHz[g_xConf.bFltWt])/dwStepFreqHz);
(0189) 		if((g_xConf.bFltWt>0) &&  (bWeight==0)) bWeight=1;
(0190) 		dwOffsetHz = dwStepFreqHz*(DWORD)bWeight; 	// slightlty inaccurate for b<~5 but error is less than one step, and at least offset = int x step
(0191) 		UART_CPutString(bufStart);
(0192) 
(0193) 		// now step through frequencies 
(0194) 		dwCurrHz_scan = dwStartFreqHz;	
(0195) 
(0196) 		do
(0197) 		{
(0198) 			// need to separate g_dwCurrHz from the scan loop variable so we can cap g_dwCurrHz at FREQ_MAX_Hz
(0199) 			// so that we don't go beyond cal max freq when using filters and needing to scan ahead
(0200) 			g_dwCurrHz=(dwCurrHz_scan<FREQ_MAX_Hz)? dwCurrHz_scan:FREQ_MAX_Hz;
(0201) 			
(0202) 			Screen_Frequency(Display_kHz);		// might be better to replace this with a % complete indicator
(0203) 			
(0204) 			// measure bridge ratios and reconstruct voltages using filter
(0205) 			// then reconstruct g_wBrgRts so all 6 params are based on filtered values			
(0206) 			MeasureBrgRts();	
(0207) 			g_wBrgRts[MODGAMMA] = filter(g_wBrgRts[MODGAMMA],MODGAMMA);
(0208) 			g_wBrgRts[MODZ] = filter(g_wBrgRts[MODZ],MODZ);
(0209) 					
(0210) 			if (dwCurrHz_scan >= (dwStartFreqHz + dwOffsetHz))	// if scanning ahead for filters, wait until we 'catch up'
(0211) 			{
(0212) 				if (mMode==SCANV)  {
(0213) 					PrintWdToSerial(g_dwCurrHz/1000 - dwOffsetHz/1000,0, ", ");
(0214) 					PrintWdToSerial(wRead_ADC_DDSON(VfPort),3, ", ");
(0215) 					PrintWdToSerial(wRead_ADC_DDSON(VrPort),3, ", ");				
(0216) 					PrintWdToSerial(wRead_ADC_DDSON(VzPort),3, ", ");
(0217) 					PrintWdToSerial(wRead_ADC_DDSON(VaPort),3, ", ");
(0218) 					PrintWdToSerial(g_bDDS_GainStep,0, "");
(0219) //					PrintWdToSerial(g_xGainDds[g_bDDS_GainStep].bGain1,0, "");
(0220) //					PrintWdToSerial(g_xGainDds[g_bDDS_GainStep].bGain2,0, "");					
(0221) 				}
(0222) 				if (mMode==SCANBR) {
(0223) 					PrintWdToSerial(g_dwCurrHz/1000 - dwOffsetHz/1000,0, ", ");
(0224)                     PrintWdToSerial(g_wBrgRts[MODZ],3, ", ");
(0225)                     PrintWdToSerial(g_wBrgRts[MODGAMMA],3, ", ");
(0226) 				}
(0227) 				// now with corrected bridge ratios
(0228) 				CorrectBrgRts(); 
(0229) 				if (mMode==SCANBR) {
(0230)                     PrintWdToSerial(g_wBrgRts[MODZ],3, ", ");
(0231)                     PrintWdToSerial(g_wBrgRts[MODGAMMA],3, "");
(0232) 				}
(0233) 				if (mMode==SCAN) {
(0234) 					Do_SZRX_Calcs();
(0235) 					pcLinkPrintToSerial(mMode, SRXZ);
(0236) 				}
(0237) 				if (mMode==SCANR) {
(0238) 					pcLinkPrintToSerial(mMode, VFVRVZVA);
(0239) 				}
(0240) 				UART_PutCRLF();
(0241) 			}
(0242) 			dwCurrHz_scan += dwStepFreqHz;
(0243) 		} while ( dwCurrHz_scan <= (dwEndFreqHz + dwOffsetHz) );
(0244) 
(0245) 	} while (FALSE);
(0246) 
(0247) 	UART_CPutString(bufEnd);
(0248) 
(0249) 	Morse_End();
(0250) }
(0251) //-----------------------------------------------------------------------------
(0252) //  FUNCTION NAME:	getFreqArg
(0253) //  DESCRIPTION: 	Get frequency argument from command line
(0254) //  ARGUMENTS:		none
(0255) // 	RETURNS: 		DWORD freq in Hz
(0256) //-----------------------------------------------------------------------------
(0257) DWORD getFreqArg(void)
(0258) {
(0259) 	char * strPtr; 						// Parameter pointer
(0260) 	strPtr = UART_szGetParam();
(0261) 	if (strPtr==NULL) {					// missing argument
(0262) 		UART_CPutString(bufErrExpectFreq);
(0263) 		return -1;
(0264) 	}
(0265) 	return atol(strPtr);	// good frequency
(0266) }
(0267) //-----------------------------------------------------------------------------
(0268) //  FUNCTION NAME:	PrintWORDtoSerial
(0269) //  DESCRIPTION: 	Given a number dwVal x wDivisor, prints to serial with appropriate 
(0270) //					decimal point 
(0271) //  ARGUMENTS:		WORD wVal = Number x wDivisor to print
(0272) //					BYTE bDecimals - number of dps
(0273) //  RETURNS: 		none.
(0274) //-----------------------------------------------------------------------------
(0275) void PrintWdToSerial(WORD wVal, BYTE bDecimals, const BYTE * termStr)
(0276) {
(0277) 	FormatNumberRJ(wVal , 6, bDecimals); 	
(0278) 	UART_PutString(g_buffer16);
(0279) 	UART_CPutString(termStr);
(0280) }
(0281) //-----------------------------------------------------------------------------
(0282) //  FUNCTION NAME:	filter
(0283) //  DESCRIPTION: 	Implements exponential-type filters for MODZ and MODGAMMA
(0284) //  ARGUMENTS:		WORD wVal = value to filter
(0285) //					RATIO_TYPE rFilter = which 'channel' of the filters to use
(0286) //  RETURNS: 		filtered value for channel rFilter
(0287) //-----------------------------------------------------------------------------
(0288) WORD filter(WORD wVal, RATIO_TYPE rFilter){
(0289) 	wVals[rFilter] = (DWORD)((DWORD)bWeight * wVals[rFilter] + (DWORD)wVal) / (1+bWeight);
(0290) 	return wVals[rFilter];
(0291) }
