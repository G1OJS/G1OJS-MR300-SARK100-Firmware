(0043) #include "storage.h"
(0044) 
(0045) #include <stdlib.h>
(0046) #include <string.h>
(0047) #include <m8c.h>
(0048) #include "PSoCAPI.h"
(0049) 
(0050) #include "glb_data.h"
(0051) #include "control.h"
(0052) #include "screens.h"
(0053) #include "morse.h"
(0054) #include "msg_generic.h"
(0055) #include "timers.h"
(0056) 
(0057) //-----------------------------------------------------------------------------
(0058) //  Macros
(0059) //-----------------------------------------------------------------------------
(0060) #define offsetof(st, m) \
(0061)     ((size_t) ( (char *)&((st *)(0))->m - (char *)0 ))
(0062) 
(0063) //-----------------------------------------------------------------------------
(0064) //  Defines
(0065) //-----------------------------------------------------------------------------
(0066) #define MAGIC_NUMBER	0x55ab
(0067) 
(0068) //-----------------------------------------------------------------------------
(0069) //  Typedefs
(0070) //-----------------------------------------------------------------------------
(0071) typedef struct							// Structure stored in EEPROM
(0072) {
(0073) 	INT rec_scCalTable[CAL_FREQS_NUM][CAL_LOAD_NUM][2];				// Cal table
(0074) 	BYTE rec_bDDS_GainStep;											// DDS Gain step
(0075) 	BYTE rec_bIsCalibrated;											// Identify defaults or calibrated
(0076) 	CONFIG_DATA rec_xConf;											// Configuration data
(0077) 	WORD rec_wMagic;												// Integrity control
(0078) 	
(0079) } RECORD_DATA;
(0080) // 
(0081) // Size = CalFreqs x CalLoads x (2+2) + 1+ 1+ 2 + 2
(0082) //		= CalFreqs x CalLoads x 4 + 6
(0083) //
(0084) //-----------------------------------------------------------------------------
(0085) //  FUNCTION NAME:	STR_SaveCalibration
(0086) //  DESCRIPTION:	Save calibration data in EEPROM
(0087) //  ARGUMENTS: 		none.
(0088) //  RETURNS:  		none.
(0089) //-----------------------------------------------------------------------------
(0090) void STR_SaveCalibration ( void )
(0091) {
(0092) 	E2PROM_bE2Write(offsetof(RECORD_DATA,rec_scCalTable), (unsigned char*) &g_scCalTable, sizeof(g_scCalTable), 25);
(0093) 	E2PROM_bE2Write(offsetof(RECORD_DATA,rec_bDDS_GainStep), &g_bDDS_GainStep, sizeof(g_bDDS_GainStep), 25);
(0094) 	E2PROM_bE2Write(offsetof(RECORD_DATA,rec_bIsCalibrated), &g_bIsCalibrated, sizeof(g_bIsCalibrated), 25);
(0095) }
(0096) //-----------------------------------------------------------------------------
(0097) //  FUNCTION NAME:	STR_SaveConfig
(0098) //  DESCRIPTION:	Save configuration data
(0099) //  ARGUMENTS:    	none.
(0100) //  RETURNS:		none.
(0101) //-----------------------------------------------------------------------------
(0102) void STR_SaveConfig ( void )
(0103) {
(0104) 	E2PROM_bE2Write(offsetof(RECORD_DATA,rec_xConf), (unsigned char*)&g_xConf, sizeof(g_xConf), 25);
(0105) }
(0106) //-----------------------------------------------------------------------------
(0107) //  FUNCTION NAME:	STR_Restore
(0108) //  DESCRIPTION:	Restores EEPROM data. In case of not initialized save defaults
(0109) //  ARGUMENTS:  	none.
(0110) //  RETURNS: 		none.
(0111) //-----------------------------------------------------------------------------
(0112) void STR_Restore ( void )
(0113) {
(0114) 	WORD magic;
(0115) 	E2PROM_E2Read(offsetof(RECORD_DATA,rec_wMagic), (unsigned char*) &magic, sizeof(WORD));
(0116) 	if (magic != MAGIC_NUMBER)
(0117) 	{	
(0118) 		STR_SaveCalibration();  // Save defaults set in glb_data.c
(0119) 		g_xConf.bCWPitch=0;
(0120) 		g_xConf.bFltWt=0;
(0121) 		g_xConf.bUserIdle=0;
(0122) 		g_xConf.bVF=2;
(0123) 		STR_SaveConfig();		// Save defaults set above
(0124) 		magic = MAGIC_NUMBER;
(0125) 		E2PROM_bE2Write(offsetof(RECORD_DATA,rec_wMagic), (unsigned char*) &magic, sizeof(magic), 25);
(0126) 	}
(0127) 	
(0128) 	E2PROM_E2Read(offsetof(RECORD_DATA,rec_scCalTable), (unsigned char*) &g_scCalTable, sizeof(g_scCalTable));
(0129) 	E2PROM_E2Read(offsetof(RECORD_DATA,rec_bDDS_GainStep), (unsigned char*)&g_bDDS_GainStep, sizeof(g_bDDS_GainStep));
(0130) 	E2PROM_E2Read(offsetof(RECORD_DATA,rec_bIsCalibrated), &g_bIsCalibrated, sizeof(g_bIsCalibrated));
(0131) 	E2PROM_E2Read(offsetof(RECORD_DATA,rec_xConf), (unsigned char*)&g_xConf, sizeof(g_xConf));
(0132) 	
(0133) 	if (g_bIsCalibrated == FALSE)		// If not calibrated presents warning text
(0134) 	{
(0135) 		Screen_Clear(); Screen_CStrAtRowCol(0,0, gErrorUncalibratedStr);
(0136) 		Morse_U();
(0137) 		Delay_64ths(TIME_FLASH_MSG);
(0138) 	}
(0139) 
(0140) }
