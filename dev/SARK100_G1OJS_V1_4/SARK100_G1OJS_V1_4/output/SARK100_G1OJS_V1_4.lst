(0094) void Screen_SRXZ (void)
(0095) {
(0096) 	// display planner ...
(0097) 	// SWR0.0 51000.000
(0098) 	// |999-j999|o=999o
(0099) 	// 0123456789012345
(0100) 	
(0101) 	// display top row for current mode & clear bottom row
(0102) 	Screen_CStrAtRowCol(0,0, gModeStr[g_bMode]);
(0103) 	Screen_CStrAtRowCol(1, 0, gBlankStr_16);
(0104) 	
(0105) 	// SWR top left
(0106) 	FormatNumberRJ_Sliding(((DWORD)g_wSwr100+5)/10, 3, 1);
(0107) 	Screen_StrAtRowCol(0, 3, g_buffer16);
(0108) 	// R bottom left
(0109) 	Screen_CStrAtRowCol(1, 0, "|");
(0110) 	FormatNumberRJ_Sliding((DWORD)g_wR10, 3, 1);
(0111) 	Screen_Str(g_buffer16);
(0112) 	// X bottom middle
(0113) 	FormatNumberRJ_Sliding((DWORD)g_wX10, 3, 1);
(0114) 	Screen_CStr("  ");			// placeholder for +j / -j
(0115) 	Screen_Str(g_buffer16);
(0116) 	Screen_CStr("| =");
(0117) 	// Z bottom right
(0118) 	FormatNumberRJ_Sliding((DWORD)g_wZ10, 3, 1);
(0119) 	Screen_Str(g_buffer16);
(0120) 	Screen_CStr("\xf4");
(0121) 	
(0122) 	// overwrite placeholder with +j / -j, moving one to the right for short numbers
(0123) 	Screen_CStrAtRowCol(1, (g_wX10>=100 && g_wX10<1000)? 5:4, (g_bSgnX=='+')? "+j":"-j");
(0124) }
