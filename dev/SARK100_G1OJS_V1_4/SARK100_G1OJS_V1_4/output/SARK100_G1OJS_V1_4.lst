                                        (0078) ;-----------------------------------------------------------------------------
                                        (0079) ;  FUNCTION NAME: _ADCINC12_CNT_ISR
                                        (0080) ;
                                        (0081) ;  DESCRIPTION:
                                        (0082) ;    Increment the upper (software) half on the counter whenever the
                                        (0083) ;    lower (hardware) half of the counter underflows.
                                        (0084) ;
                                        (0085) ;-----------------------------------------------------------------------------
                                        (0086) ;
                                        (0087) _ADCINC12_CNT_ISR:

(0088)    inc [ADCINC12_cCounterU]
                                        (0089)    ;@PSoC_UserCode_BODY_1@ (Do not change this line.)
                                        (0090)    ;---------------------------------------------------
                                        (0091)    ; Insert your custom code below this banner
                                        (0092)    ;---------------------------------------------------
                                        (0093)    ;   NOTE: interrupt service routines must preserve
                                        (0094)    ;   the values of the A and X CPU registers.
                                        (0095) 
                                        (0096)    ;---------------------------------------------------
                                        (0097)    ; Insert your custom code above this banner
                                        (0098)    ;---------------------------------------------------
                                        (0099)    ;@PSoC_UserCode_END@ (Do not change this line.)
(0100)    reti
                                        (0101) 
                                        (0102) ;-----------------------------------------------------------------------------
                                        (0103) ;  FUNCTION NAME: _ADCINC12_TMR_ISR
                                        (0104) ;
                                        (0105) ;  DESCRIPTION:
                                        (0106) ;    This routine allows the counter to collect data for 64 timer cycles
                                        (0107) ;    This routine then holds the integrater in reset for one cycle while
                                        (0108) ;    the A/D value is calculated.
                                        (0109) ;
                                        (0110) ;-----------------------------------------------------------------------------
                                        (0111) ;
                                        (0112) _ADCINC12_TMR_ISR:
(0113)    dec [ADCINC12_cTimerU]
                                        (0114) ;  if(upper count >0 )
(0115)    jz  else1
(0116)       reti
                                        (0117)    else1:;(upper count decremented to 0)
(0118)       tst reg[ADCINC12_AtoDcr3],10h
(0119)       jz   else2
                                        (0120) ;     if(A/D has been in reset mode)
(0121)          nop                                     ; Dummy statement to keep time
                                        (0122)                                              ; between turning on and off counter
                                        (0123)                          ; the same.
(0124)          mov reg[ADCINC12_CounterCR0],(ADCINC12_fDBLK_ENABLE|ADCINC12_fPULSE_WIDE)    ; Enable Counter
(0125)          and reg[ADCINC12_AtoDcr3],~10h          ; Enable Analog Integrator
                                        (0126) IF ADCINC12_NoAZ
(0127)          and reg[ADCINC12_AtoDcr2],~20h
                                        (0128) ENDIF
(0129)          mov [ADCINC12_cTimerU],(1<<(ADCINC12_NUMBITS - 6))
                                        (0130)                                                  ; This will be the real counter value
(0131)          reti
                                        (0132)       else2:;(A/D has been in integrate mode)
(0133)          M8C_SetBank1
(0134)          and reg[ADCINC12_CounterSL], 0x0F       ; Disable input to counter
(0135)          M8C_SetBank0
                                        (0136) 
(0137)          or  F,01h                               ;Enable the interrupts
                                        (0138)          ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
                                        (0139)          ; Good place to add code to switch inputs for multiplexed input to ADC
                                        (0140)          ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
                                        (0141)          ;@PSoC_UserCode_BODY_2@ (Do not change this line.)
                                        (0142)          ;---------------------------------------------------
                                        (0143)          ; Insert your custom code below this banner
                                        (0144)          ;---------------------------------------------------
                                        (0145)          ;   NOTE: interrupt service routines must preserve
                                        (0146)          ;   the values of the A and X CPU registers.
                                        (0147) 
                                        (0148)          ;---------------------------------------------------
                                        (0149)          ; Insert your custom code above this banner
                                        (0150)          ;---------------------------------------------------
                                        (0151)          ;@PSoC_UserCode_END@ (Do not change this line.)
                                        (0152) 
                                        (0153) IF ADCINC12_NoAZ
(0154)          or  reg[ADCINC12_AtoDcr2],20h           ;Reset Integrator
                                        (0155) ENDIF
(0156)          or  reg[ADCINC12_AtoDcr3],10h
(0157)          push A
(0158)          mov A, reg[ADCINC12_CounterDR0]         ;read Counter
(0159)          mov A, reg[ADCINC12_CounterDR2]         ;now you really read the data
                                        (0160) 
(0161)          mov reg[ADCINC12_CounterCR0],00h        ;disable counter
(0162)      M8C_SetBank1
(0163)          or  reg[ADCINC12_CounterSL],ADCINC12_CNTINPUT  ; Reconnect counter to comparitor
(0164)      M8C_SetBank0
                                        (0165) 
                                        (0166) 
(0167)          cpl A
(0168)          cmp [ADCINC12_cCounterU],(1<<(ADCINC12_NUMBITS - 7))
(0169)          jnz endif10
                                        (0170) ;        if(max positive value)
(0171)             dec [ADCINC12_cCounterU]
(0172)             mov A,ffh
                                        (0173)          endif10:
(0174)          asr [ADCINC12_cCounterU]                ; divide by 4
(0175)          rrc A
(0176)          asr [ADCINC12_cCounterU]
(0177)          rrc A
                                        (0178) ;
(0179)          mov [(ADCINC12_iIncr + HighByte)],[ADCINC12_cCounterU]
(0180)          mov [(ADCINC12_iIncr + LowByte)],A
(0181)          mov [ADCINC12_fIncr],01h                ;Set AD data flag
(0182)          pop A
                                        (0183)          ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
                                        (0184)          ; User code here for interrupt system.
                                        (0185)          ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
                                        (0186) 
                                        (0187)          ;@PSoC_UserCode_BODY_3@ (Do not change this line.)
                                        (0188)          ;---------------------------------------------------
                                        (0189)          ; Insert your custom code below this banner
                                        (0190)          ;---------------------------------------------------
                                        (0191)          ;   NOTE: interrupt service routines must preserve
                                        (0192)          ;   the values of the A and X CPU registers.
                                        (0193) 
                                        (0194)          ;---------------------------------------------------
                                        (0195)          ; Insert your custom code above this banner
                                        (0196)          ;---------------------------------------------------
                                        (0197)          ;@PSoC_UserCode_END@ (Do not change this line.)
                                        (0198) 
(0199)          cmp [ADCINC12_bIncrC],00h
(0200)          jz  endif3
                                        (0201) ;        if(ADCINC12_bIncrC is not zero)
(0202)             dec [ADCINC12_bIncrC]
(0203)             jnz endif4
                                        (0204) ;           if(ADCINC12_bIncrC has decremented down to zero to 0)
(0205)                mov reg[ADCINC12_TimerCR0],00h      ;disable the Timer
(0206)                mov reg[ADCINC12_CounterCR0],00h    ;disable the Counter
(0207)                nop
(0208)                nop
(0209)                and reg[INT_MSK1],~(ADCINC12_TimerMask | ADCINC12_CounterMask)
                                        (0210)                                                            ;Disable both interrupts
                                        (0211) IF ADCINC12_NoAZ
(0212)                or  reg[ADCINC12_AtoDcr2],20h       ;Reset Integrator
                                        (0213) ENDIF
(0214)                or  reg[ADCINC12_AtoDcr3],10h
(0215)                reti
                                        (0216)             endif4:;
                                        (0217)          endif3:;
                                        (0218)       endif2:;
(0219)       mov [ADCINC12_cTimerU],1                     ;Set Timer for one cycle of reset
(0220)       mov [ADCINC12_cCounterU],(-(1<<(ADCINC12_NUMBITS - 7)))  ;Set Counter hardware for easy enable
(0221)       mov reg[ADCINC12_CounterDR1],ffh
(0222)       reti
(0223)    endif1:;
(0224) 
(0225) ; end of file ADCINC12INT.asm
