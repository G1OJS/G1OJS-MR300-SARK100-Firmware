(0022) //*****************************************************************************/
(0023) //
(0024) //	PROJECT:	SARK100 SWR Analyzer
(0025) // 	FILE NAME: 	correctionmodel.c
(0026) // 	AUTHOR:		Alan Robinson
(0027) //
(0028) // 	DESCRIPTION: Characterises the bridge by recording the measured bridge ratios
(0029) //				 across frequency for a set of known loads. Encodes the characterisation
(0030) //				 data using a Moebius Transform for compact storage. Decodes the 
(0031) //				 characterisation data and corrects measurements.
(0032) //
(0033) // 	HISTORY
(0034) //	NAME   	DATE		REMARKS
(0035) //	AJR		JAN 2025	Creation
(0036) //*****************************************************************************/
(0037) #include "correctionmodel.h"
(0038) 
(0039) #include "control.h"
(0040) #include "storage.h"
(0041) #include "glb_data.h"
(0042) #include "keypad.h"
(0043) #include "msg_generic.h"
(0044) #include "morse.h"
(0045) #include "screens.h"
(0046) #include "bridge.h"
(0047) #include "derive.h"
(0048) #include "timers.h"
(0049) #include "UART.h"
(0050) #include "pclink_cmds.h"
(0051) 
(0052) typedef enum {STORE, RETRIEVE} ENCODE_DIRECTION;
(0053) 
(0054) //-----------------------------------------------------------------------------
(0055) //  Prototypes
(0056) //-----------------------------------------------------------------------------
(0057) WORD wCalRatio(BYTE bLoad, RATIO_TYPE rRatio);
(0058) static long lLinMap(long lVal, long lSource1, long lSource2, long lDest1, long lDest2);
(0059) WORD wLincor(WORD X, WORD M0, WORD M1, WORD T0, WORD T1);
(0060) WORD wTrueLoadRatios(BYTE bLoad, RATIO_TYPE rRatio);
(0061) static INT iRatioFromCalibration(ENCODE_DIRECTION xDir, RATIO_TYPE xType, INT iRatio_true, INT iRatio);
(0062) BYTE getUserConfirmation(void);
(0063) static long min_long(long a, long b);
(0064) static long max_long(long a, long b);
(0065) 
(0066) //-----------------------------------------------------------------------------
(0067) //  FUNCTION NAME:	min_long
(0068) //-----------------------------------------------------------------------------
(0069) static long min_long(long a, long b) {
(0070)     return (a > b) ? b : a;
(0071) }
(0072) 
(0073) //-----------------------------------------------------------------------------
(0074) //  FUNCTION NAME:	max_long
(0075) //-----------------------------------------------------------------------------
(0076) static long max_long(long a, long b) {
(0077)     return (a > b) ? a : b;
(0078) }
(0079) 
(0080) //-----------------------------------------------------------------------------
(0081) //  FUNCTION NAME:	MeasureUncorrectedRatios()
(0082) //  DESCRIPTION:	Calibration routine
(0083) //  ARGUMENTS: 		none.
(0084) //  RETURNS:		none.
(0085) //-----------------------------------------------------------------------------
(0086) void MeasureUncorrectedRatios (void)
(0087) {
(0088) 	BYTE bCalFreqIndex;
(0089) 	BYTE bFirst;
(0090) 	RATIO_TYPE rRatio;
(0091) 	BYTE bLoad;
(0092) 	M8C_EnableGInt ;
(0093) 	
(0094) 	do
(0095) 	{
(0096) 		Screen_Clear();
(0097) 		Screen_HideCursor();
(0098) 	
(0099) 		// Find DDS Gain step needed for reasonable Vf 
(0100) 		// This is also an opportunity to abort the calibration without changing anything:
(0101) 		Screen_Clear(); Screen_CStrAtRowCol(0,0, gDisconnectLoadStr);
(0102) 		if(!getUserConfirmation()) break;
(0103)   		Screen_CStrAtRowCol(1, 0, gSettingGainStr);
(0104) 		g_dwCurrHz=FREQ_MIN_Hz;
(0105) 		DDS_Autolevel();
(0106) 	
(0107) 		// now measure and store the uncalibrated ratios Vz/Va and Vr/Vf at each cal frequency and load			
(0108) 		for (bLoad=0; bLoad < CAL_LOAD_NUM; bLoad++)
(0109) 		{
(0110) 			Morse_Dah();
(0111) 			Screen_Clear(); Screen_CStrAtRowCol(0,0, gCalLoadStr[bLoad]);
(0112) 			if(!getUserConfirmation()) break;
(0113) 			Screen_Clear(); Screen_CStrAtRowCol(1, 0, gCalibratingStr);		
(0114) 			for (bCalFreqIndex=0; bCalFreqIndex<CAL_FREQS_NUM;bCalFreqIndex++)
(0115) 			{
(0116) 				g_dwCurrHz=CAL_START_kHz*1000 + (DWORD)bCalFreqIndex * CAL_FREQ_STEP_kHz*1000 ;
(0117) 				Screen_Frequency(Display_Hz);
(0118) 				MeasureBrgRts();
(0119) 				for (rRatio=MODZ; rRatio <= MODGAMMA; rRatio++) {
(0120) 					g_scCalTable[bCalFreqIndex][bLoad][rRatio] = iRatioFromCalibration(STORE, rRatio, wTrueLoadRatios(bLoad,rRatio), g_wBrgRts[rRatio]);
(0121) 				}
(0122) 			}
(0123) 		}
(0124) 
(0125) 		// Store cal factors in EEPROM
(0126) 		g_bIsCalibrated=TRUE; // this needs to be set to True here, and only here
(0127) 		STR_SaveCalibration();
(0128) 	
(0129) 		// Finish, alert user
(0130) 		Screen_Clear();
(0131) 		Screen_CStrAtRowCol(0,0, gConfigDoCalStr);
(0132) 		Screen_CStrAtRowCol(1,0, gDoneRestartingStr);
(0133) 		Morse_End();
(0134) 		Delay_64ths(TIME_FLASH_MSG);
(0135) 		M8C_DisableGInt;
(0136) 		asm ("ljmp 0x0000"); // Perform Software Reset
(0137) 	
(0138) 	} while (FALSE);
(0139) 
(0140) }
(0141) //-----------------------------------------------------------------------------
(0142) //  FUNCTION NAME:	iRatioFromCalibration
(0143) //
(0144) //  DESCRIPTION:	Encodes or decodes a ratio measured during calibration 
(0145) //					so that the encoded result can be stored in the
(0146) //					BYTE arrays [bCalFreqIndex][bLoad] 
(0147) //					The measured ratio is first scaled to the true ratio, and then
(0148) //					log-like encoding is used to allow (measured/true) to range from
(0149) //						1/2 to 2 for (Vr/Vf measured) / (Vr/Vf true) -> -127 to 127 
(0150) //						1/5 to 5 for (Vz/Va measured) / (Vz/Va true) -> -127 to 127
(0151) //					hence the result can be encoded in an array of signed char.
(0152) //					Using signed innteger for the output and inputs means that the
(0153) //					single function can be used in each direction (encode & decode)
(0154) //
(0155) //  ARGUMENTS:		xDir		= STORE | RETRIEVE
(0156) //					xType	 	= MODZ | MODGAMMA
(0157) //					iRatio_true	= true ratio for the cal point scaled by wUNITY
(0158) //					iRatio		= ratio scaled by wUNITY, or encoded value, to convert 
(0159) //
(0160) //  RETURNS: 		signed int	= encoded value (range -127 to 127) when encoding
(0161) //					signed int	= Measured ratio (range 0 to 32767 scaled by wUNITY) when decoding
(0162) //
(0163) //	NOTES:			Whilst |Z|/50 can range to 65537/wUNITY, 32767 is enough for
(0164) //					the largest calibration load (560 ohms, true ratio 11200/wUNITY)
(0165) //					|Gamma| ranges 0 to 1000/wUNITY or slightly over with measurement error
(0166) //					The encoded output has zero indicating measured ratio = true ratio, so
(0167) //					the calibration table is initialised to zero by default
(0168) //-----------------------------------------------------------------------------
(0169) 
(0170) static INT iRatioFromCalibration(ENCODE_DIRECTION xDir, RATIO_TYPE xType, INT iRatio_true, INT iRatio) {
(0171) 	long lNum;
(0172) 	long lDenom;
(0173) 	INT iScale;
(0174) 	BYTE bDyRNG = (xType==MODGAMMA)? 3:6; 	// dynamic range 1/n to n
(0175) 	
(0176) 	#define ENC_MAX 127						// encoded range -127 to +127
(0177) 	
(0178) 	iScale = (ENC_MAX*(int)(bDyRNG+1)) /(int)(bDyRNG-1);
(0179) 
(0180) 	if(xDir==STORE) {
(0181)     	lNum = iScale*(long)iRatio - (long)iScale*(long)iRatio_true;
(0182)     	lDenom = (long)iRatio + (long)iRatio_true;
(0183) 		if (lDenom==0) {return 0;} else {				// lim x,y->0 of (x-y)/(x+y) is 0
(0184) 			lNum /=lDenom;								// re-using the numerator var for the result
(0185) 			lNum = (lNum>ENC_MAX)? ENC_MAX:lNum;		// clamp at +/- ENC_MAX; better than wrapped if stored in 8 bits
(0186) 			lNum = (lNum<-ENC_MAX)? -ENC_MAX:lNum;		
(0187)     		return lNum; 
(0188) 		}
(0189) 	} else {
(0190) 	    lNum = (long)iRatio_true*(long)iScale+(long)iRatio_true*(long)iRatio;
(0191)     	lDenom = (long)iScale - (long)iRatio;
(0192)     	return lNum / lDenom;  
(0193) 	}
(0194) }
(0195) //-----------------------------------------------------------------------------
(0196) //  FUNCTION NAME:	CorrectBrgRts()
(0197) //  DESCRIPTION:	Use a mapping function to map the current measured ratios
(0198) //					to the true values that they should represent.
(0199) //  ARGUMENTS:		none
(0200) //  RETURNS: 		nothing
(0201) //-----------------------------------------------------------------------------
(0202) 
(0203) void CorrectBrgRts (void)
(0204) {
(0205) 	// 1) Mod Gamma
(0206) 	g_wBrgRts[MODGAMMA] = wLincor(g_wBrgRts[MODGAMMA], wCalRatio(2,MODGAMMA), wCalRatio(3,MODGAMMA), CALMG_H, CALMG_H2) ;
(0207) 	g_wBrgRts[MODGAMMA] = min_long(VR_OVER_VF_MAX,g_wBrgRts[MODGAMMA]);
(0208) 		
(0209) 	// 2) Mod Z
(0210) 	if(g_wBrgRts[MODZ]<wUNITY) {
(0211) 		g_wBrgRts[MODZ] = lLinMap(g_wBrgRts[MODZ], wCalRatio(0,MODZ), wCalRatio(1,MODZ), CALMZ_L,  CALMZ_M);
(0212) 	} else {
(0213) 		g_wBrgRts[MODZ] = lLinMap(g_wBrgRts[MODZ], wCalRatio(1,MODZ), wCalRatio(2,MODZ), CALMZ_M,  CALMZ_H);	
(0214) 	}
(0215) }
(0216) 
(0217) WORD wLincor(WORD X, WORD M0, WORD M1, WORD T0, WORD T1)
(0218) {
(0219)     WORD m;
(0220) 	int c;
(0221) 	WORD r;
(0222) 	
(0223) 	m = (DWORD)(wUNITY*(T1-T0))/(M1-M0);
(0224) 	c = T0 - (signed long)(m * M0)/wUNITY;
(0225) 	r = (long)(r * m)/wUNITY + c;
(0226) 	
(0227) 	return r;
(0228) }
(0229) 
(0230) //-----------------------------------------------------------------------------
(0231) //  FUNCTION NAME:	wCalRatio(BYTE bLoad, RATIO_TYPE rRatio)
(0232) //  DESCRIPTION:	Retrieves the ratio measured during calibration
(0233) //					interpolated to the current frequency g_dwCurrHz
(0234) //  ARGUMENTS:		bLoad - the load index
(0235) //					rRatio - the ratio type
(0236) //  RETURNS:		(rRatio = MODGAMMA): Vr/Vf; (rRatio=MODZ): Va/Vz
(0237) //-----------------------------------------------------------------------------
(0238) WORD wCalRatio(BYTE bLoad, RATIO_TYPE rRatio) 
(0239) {
(0240) 	BYTE bCalFreqIndex = (g_dwCurrHz/1000-CAL_START_kHz) / (CAL_FREQ_STEP_kHz);
(0241) 	return lLinMap(g_dwCurrHz/1000-CAL_START_kHz, (DWORD)bCalFreqIndex * CAL_FREQ_STEP_kHz, (DWORD)(1+bCalFreqIndex) * CAL_FREQ_STEP_kHz,
(0242) 		iRatioFromCalibration(RETRIEVE, rRatio, wTrueLoadRatios(bLoad, rRatio), g_scCalTable[bCalFreqIndex][bLoad][rRatio]), 
(0243) 		iRatioFromCalibration(RETRIEVE, rRatio, wTrueLoadRatios(bLoad, rRatio), g_scCalTable[bCalFreqIndex+1][bLoad][rRatio]) );		
(0244) }
(0245) 
(0246) WORD wTrueLoadRatios(BYTE bLoad, RATIO_TYPE rRatio)
(0247) {
(0248) 	if (bLoad==0) return ((rRatio==MODZ)? CALMZ_L:CALMG_L);
(0249) 	if (bLoad==1) return ((rRatio==MODZ)? CALMZ_M:CALMG_M);
(0250) 	if (bLoad==2) return ((rRatio==MODZ)? CALMZ_H:CALMG_H);
(0251) 	if (bLoad==3) return ((rRatio==MODZ)? CALMZ_H2:CALMG_H2);
(0252) 	return -1;
(0253) }
(0254) 
(0255) //-----------------------------------------------------------------------------
(0256) //  FUNCTION NAME:	lLinMap(long lVal, long lSource1, long lSource2, long lDest1, long lDest2)
(0257) //  DESCRIPTION:	Maps the range lSource1 .. lSource2 onto lDest1 .. lDest2
(0258) //  				The function works to the precision set by the wUNITY #def
(0259) //  ARGUMENTS:
(0260) //		lVal - the value to map
(0261) //		lSource1, lSource2, lDest1, lDest2 - end points of the mapping ranges
(0262) //  RETURNS:
(0263) //     	long - the input value mapped into the destination range
(0264) //-----------------------------------------------------------------------------
(0265) static long lLinMap(long lVal, long lSource1, long lSource2, long lDest1, long lDest2)
(0266) {
(0267) 	long lAlpha = ((long)wUNITY*(lVal - lSource1))/(lSource2-lSource1);
(0268) 	return lDest1 + (lAlpha * (lDest2-lDest1)) / wUNITY;
(0269) }
(0270) 
(0271) 
