                                        (0229) ;-----------------------------------------------------------------------------
                                        (0230) ;  MACRO NAME: SSC_Action
                                        (0231) ;
                                        (0232) ;  DESCRIPTION:
                                        (0233) ;     Performs locally defined supervisory operations.
                                        (0234) ;
                                        (0235) ;     !!! DO NOT CHANGE THIS CODE !!!
                                        (0236) ;        This sequence of opcodes provides a
                                        (0237) ;        signature for the debugger and ICE.
                                        (0238) ;     !!! DO NOT CHANGE THIS CODE !!!
                                        (0239) ;
                                        (0240) ;  ARGUMENTS:
                                        (0241) ;     BYTE  bOperation   - specified supervisory operation - defined operations
                                        (0242) ;                          are:  FLASH_WRITE, FLASH_ERASE, FLASH_TEMP_TABLE_LOOKUP.
                                        (0243) ;
                                        (0244) ;  RETURNS:
                                        (0245) ;     none.
                                        (0246) ;
                                        (0247) ;  SIDE EFFECTS:
                                        (0248) ;     A and X registers are destroyed
                                        (0249) ;
                                        (0250) ;  PROCEDURE:
                                        (0251) ;     1) specify a 3 byte stack frame.  Save in [KEYSP]
                                        (0252) ;     2) insert the flash Supervisory key in [KEY1]
                                        (0253) ;     3) store flash operation function code in A
                                        (0254) ;     4) call the supervisory code
                                        (0255) ;-----------------------------------------------------------------------------
                                        (0256) macro SSC_Action
                                        (0257)       mov   X, SP                         ; copy SP into X
                                        (0258)       mov   A, X                          ; mov to A
                                        (0259)       add   A, 3                          ; create 3 byte stack frame
                                        (0260)       mov   [bSSC_KEYSP], A               ; save stack frame for supervisory code
                                        (0261)       mov   [bSSC_KEY1], FLASH_OPER_KEY   ; load the supervisory code for flash operations
                                        (0262)       mov   A, @0                         ; load A with specific Flash operation
                                        (0263)       SSC                                 ; SSC call the supervisory code
                                        (0264) endm
                                        (0265) 
                                        (0266) ;-----------------------------------------------------------------------------
                                        (0267) ;  FUNCTION NAME: bFlashWriteBlock
                                        (0268) ;
                                        (0269) ;  DESCRIPTION:
                                        (0270) ;     Writes 64 bytes of data to the flash at the specified blockId.
                                        (0271) ;
                                        (0272) ;     Regardless of the size of the buffer, this routine always writes 64
                                        (0273) ;     bytes of data. If the buffer is less than 64 bytes, then the next
                                        (0274) ;     64-N bytes of data will be written to fill the rest of flash block data.
                                        (0275) ;
                                        (0276) ;  ARGUMENTS:
                                        (0277) ;     X ->  psBlockWriteData  -  a structure that holds the
                                        (0278) ;                                calling arguments and some reserved space
                                        (0279) ;
                                        (0280) ;  RETURNS:
                                        (0281) ;     BYTE - successful if NON-Zero returned.
                                        (0282) ;
