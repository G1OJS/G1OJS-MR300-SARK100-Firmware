                                        (0036)     ADCINC12_cTimerU:   BLK  1                   ;The Upper byte of the Timer
                                        (0037)     ADCINC12_cCounterU: BLK  1                   ;The Upper byte of the Counter
                                        (0038)    _ADCINC12_iIncr:
                                        (0039)     ADCINC12_iIncr:     BLK  2                   ;A/D value
                                        (0040)    _ADCINC12_fIncr:
                                        (0041)     ADCINC12_fIncr:     BLK  1                   ;Data Valid Flag
                                        (0042)     ADCINC12_bIncrC:    BLK  1                   ;# of times to run A/D
                                        (0043) 
