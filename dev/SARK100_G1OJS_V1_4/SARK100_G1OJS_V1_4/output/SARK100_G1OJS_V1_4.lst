(0392) //-----------------------------------------------------------------------------
(0393) //  FUNCTION NAME:	FormatNumberRJ
(0394) //  DESCRIPTION: 	Bespoke ultoa eliminates library calls & saves 700 bytes ROM
(0395) //                  Results are right-justified if bFieldLen > len needed.
(0396) //  ARGUMENTS: 		dwVal 		- number to convert
(0397) //					bFieldLen	- number of digits (including the decimal point)
(0398) //                                beyond which **** is the result
(0399) //					bDP		 	- number of decimal places
(0400) //                              - FIXED - fixes the number of decimal places
(0401) //  RETURNS: 		true        - OK
(0402) //                  false       - Overrange (digits won't fit in bFieldLen)
(0403) //-----------------------------------------------------------------------------
(0404) char FormatNumberRJ(unsigned long dwVal, unsigned char bFieldLen, unsigned char bDP)
(0405) {
(0406) 	// sequentially extract the digits into the buffer, inserting the 
(0407) 	// decimal point at the appropriate place, then terminate the string
(0408)     // Convert number to string with correct decimal placement
(0409)     unsigned char index=0;
(0410)     while (index < bFieldLen ) {  
(0411)         g_buffer16[bFieldLen-1-index++] = '0' + (dwVal % 10);
(0412)         if(index==bDP) g_buffer16[bFieldLen-1-index++]='.';
(0413)         dwVal /= 10;
(0414)     }
(0415)     g_buffer16[bFieldLen]='\0';
(0416)     // if dwVal still has a value to encode,  return false
(0417)   	if(dwVal>0) return 0;
(0418)     // tidy up any unnecessary leading zeros (right justify so don't move digits)
(0419) 	index=0;
(0420) 	while (g_buffer16[index]=='0' && g_buffer16[index+1]!='.' && g_buffer16[index+1]!='\0') {g_buffer16[index++]=' ';}
(0421) 	
(0422) 	return 1;
(0423) }
(0424) 
(0425) 
