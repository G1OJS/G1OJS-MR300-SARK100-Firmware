7D48: 51 B0    MOV   A,[__r1]           (0179) 	mov A,[__r1]
7D4A: 08       PUSH  A                  (0180) 	push A
7D4B: 51 AF    MOV   A,[__r2]           (0181) 	mov A,[__r2]
