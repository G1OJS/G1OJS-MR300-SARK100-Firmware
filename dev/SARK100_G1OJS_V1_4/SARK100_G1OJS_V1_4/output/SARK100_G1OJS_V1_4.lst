                                        (0056) ; LoadConfigInit - Establish the start-up configuration (except for a few
                                        (0057) ;                  parameters handled by boot code, like CPU speed). This
                                        (0058) ;                  function can be called from user code, but typically it
                                        (0059) ;                  is only called from boot.
                                        (0060) ;
                                        (0061) ;       INPUTS: None.
                                        (0062) ;      RETURNS: Nothing.
                                        (0063) ; SIDE EFFECTS: Registers are volatile: the A and X registers can be modified!
                                        (0064) ;               In the large memory model currently only the page
                                        (0065) ;               pointer registers listed below are modified.  This does
                                        (0066) ;               not guarantee that in future implementations of this
                                        (0067) ;               function other page pointer registers will not be
                                        (0068) ;               modified.
                                        (0069) ;          
                                        (0070) ;               Page Pointer Registers Modified: 
                                        (0071) ;               CUR_PP
                                        (0072) ;
                                        (0073) _Boot_LoadConfigInit:
                                        (0074)  Boot_LoadConfigInit:
                                        (0075)     RAM_PROLOGUE RAM_USE_CLASS_4
