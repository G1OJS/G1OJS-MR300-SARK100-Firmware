(0023) //
(0024) //	PROJECT:	SARK100 SWR Analyzer
(0025) // 	FILE NAME: 	morse.c
(0026) // 	AUTHOR:		G1OJS - Alan Robinson
(0027) // 	DESCRIPTION	Uses the PWM_Buzzer to create morse code notifications
(0028) // 	HISTORY
(0029) //	NAME   		DATE		REMARKS
(0030) //	AJR			Feb 2025	G1OJS  - creation
(0031) //*****************************************************************************/
(0032) #include "morse.h"
(0033) #include "control.h"
(0034) #include "glb_data.h"
(0035) #include "timers.h"
(0036) 
(0037) #define CW_WPM 20
(0038) #define CW_DitNum 1200
(0039) #define CW_DahNum 3600
(0040) 
(0041) 
(0042) // to do - define MORSE_ENSIGN DIT|DAH, have one function Morse(MORSE_ENSIGN) OR classic Morse("-.-");
(0043) 
(0044) void Morse_U(void)			{ Morse_Dit(); Morse_Dit(); Morse_Dah();		}
(0045) void Morse_K(void)			{ Morse_Dah(); Morse_Dit(); Morse_Dah();		}
(0046) void Morse_Err(void)		{ BYTE bCnt=0; for(;bCnt<8;bCnt++) {Morse_Dit(); }		}
(0047) void Morse_End(void)		{ BYTE bCnt=0; for(;bCnt<3;bCnt++) {Morse_Dit();} Morse_Dah(); Morse_Dit(); Morse_Dah(); }
(0048) 
(0049) void Morse_Dit(void) 		{ Tone(100*g_bCWPitches[g_xConf.bCWPitch], CW_DitNum / CW_WPM); Tone(0, CW_DitNum / CW_WPM);	}
(0050) void Morse_Dah(void)		{ Tone(100*g_bCWPitches[g_xConf.bCWPitch], CW_DahNum / CW_WPM); Tone(0, CW_DitNum / CW_WPM);  }
(0051) 
(0052) void Tone(WORD wPitch_Hz, BYTE bLen_ms)
(0053) {
(0054) 	#define ticks_per_us 15625
(0055) 	BYTE b64ths;
(0056) 	if(wPitch_Hz>16000)  wPitch_Hz=16000; 	
(0057) 	if(wPitch_Hz>0) {								// b_Pitch_kHz==0 signifies silent delay
(0058)  		PWM8_BUZZ_WritePeriod(32000/wPitch_Hz);		// Set period in clock ticks (clock 32Khz). Must be at least 2!
(0059) 		PWM8_BUZZ_WritePulseWidth(16000/wPitch_Hz);	// Set pulse width to generate a 50% duty cycle
(0060) 		PWM8_BUZZ_DisableInt();						// Ensure interrupt is disabled
(0061) 		PWM8_BUZZ_Start(); 							// Start the buzzer
(0062) 	}
(0063) 	b64ths=(BYTE)(  ((DWORD)bLen_ms*1000) / ticks_per_us  );
(0064) 	if(b64ths<1) b64ths=1;
(0065) 	Delay_64ths(b64ths);							// wait approx bLen_ms
(0066) 	if(wPitch_Hz>0) PWM8_BUZZ_Stop();				// Stop the buzzer if we started it	
(0067) }
