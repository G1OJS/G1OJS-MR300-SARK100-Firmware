(0027) // 	FILE NAME: 	KEYPAD.C
(0028) // 	AUTHOR:		Melchor Varela
(0029) // 	DESCRIPTION: Keypad driver
(0030) // 	HISTORY
(0031) //	NAME   		DATE		REMARKS
(0032) //	MVM	   		DEC 2009	Creation
(0033) //  AJR			JAN 2025	Added comments and changed function names to 
(0034) //							be more descriptive.
