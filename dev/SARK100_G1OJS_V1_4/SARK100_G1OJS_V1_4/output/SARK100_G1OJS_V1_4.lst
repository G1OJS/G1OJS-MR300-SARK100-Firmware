                                        (0001) ;------------------------------------------------------------------------------
                                        (0002) ;   FILENAME:   FlashBlock.asm
                                        (0003) ;    @Version@
                                        (0004) ;------------------------------------------------------------------------------
                                        (0005) ;   DESCRIPTION:
                                        (0006) ;   Routines in this file perform Flash Block Write and Read operations for
                                        (0007) ;   Large Memory Model family members of the Ge family - CY8C27060 and CY8C29xxx
                                        (0008) ;------------------------------------------------------------------------------
                                        (0009) ;   Copyright (c) Cypress MicroSystems 2004. All rights reserved.
                                        (0010) ;------------------------------------------------------------------------------
                                        (0011) 
                                        (0012) export    bFlashWriteBlock
                                        (0013) export   _bFlashWriteBlock
                                        (0014) export    FlashReadBlock
                                        (0015) export   _FlashReadBlock
                                        (0016) export   FlashCheckSum
                                        (0017) export   _FlashCheckSum
                                        (0018) export   Boot_Is_Program_Good
                                        (0019) export   _Boot_Is_Program_Good
                                        (0020) 
                                        (0021) 
                                        (0022) include "m8c.inc"
                                        (0023) include "memory.inc"
                                        (0024) include "flashblock.inc"
                                        (0025) 
                                        (0026) 
                                        (0027) Area BootLoaderArea(ROM,REL)
                                        (0028) ;--------------------------------------------
                                        (0029) ;  Declare Flash RAM storage at top of RAM
                                        (0030) ;     This data area is reserved for exclusive
                                        (0031) ;     use by Supervisory operations.
                                        (0032) ;--------------------------------------------
                                        (0033)    area SSCParmBlk(RAM,ABS)
                                        (0034)    org  00F8H
                                        (0035) 
                                        (0036) 
                                        (0037) SSCParameterBlk:                   blk      8     ; reserve 8 bytes: F8 - FF for supervisory operation
                                        (0038) 
                                        (0039) ;--------------------------------
                                        (0040) ; SSC_Action macro command codes
                                        (0041) ;--------------------------------
                                        (0042) FLASH_OPER_KEY:                     equ      3Ah   ; flash operation key
                                        (0043) FLASH_WRITE:                        equ      2     ; flash write operation supervisory command
                                        (0044) FLASH_ERASE:                        equ      3     ; flash erase operation supervisory command
                                        (0045) FLASH_TEMP_TABLE_LOOKUP:            equ      6     ; flash temperature table command
                                        (0046) 
                                        (0047) ;-------------------------------------
                                        (0048) ; Flash temperature programming table
                                        (0049) ;-------------------------------------
                                        (0050) TEMPERATURE_TABLE_ID:               equ      3     ; flash temperature programming table ID
                                        (0051) 
                                        (0052) ;--------------------------------------------------------------
                                        (0053) ; Supervisory Operation Templates:
                                        (0054) ;     Each system supervisory call uses the reserved data area
                                        (0055) ;     a little different.  Create overlay templates to improve
                                        (0056) ;     readability and maintenance.
                                        (0057) ;--------------------------------------------------------------
                                        (0058) 
                                        (0059) ;Common Supervisory Code Variables
                                        (0060)    bSSC_KEY1:                       equ      F8h   ; supervisory key
                                        (0061)    bTEMP_SPACE:                     equ      F8h   ; temporary storage when not used for KEY1
                                        (0062)    bSSC_KEYSP:                      equ      F9h   ; supervisory stack ptr key
                                        (0063)    bSSC_ResultCode:                 equ      F8h   ; result code
                                        (0064) 
                                        (0065) ;SSC Return Codes
                                        (0066)    bSSC_FAIL:                       equ      01h   ; fail return code
                                        (0067)    bSSC_SUCCESS:                    equ      00h   ; success return code
                                        (0068) 
                                        (0069) ;Flash Erase Operation Template
                                        (0070)    bSSC_FLASH_BlockId:              equ      FAh   ; blockId for Erase and Read
                                        (0071)    bSSC_FLASH_BlockID_BANK:         equ      FAh   ; block ID page register in bank 1
                                        (0072)    bSSC_FLASH_PulseWidth:           equ      FCh   ; Erase pulse width
                                        (0073) 
                                        (0074) ;Flash Write Operation Template
                                        (0075)    bSSC_WRITE_BlockId:              equ      FAh   ; block ID
                                        (0076)    bSSC_WRITE_BlockID_BANK:         equ      FAh   ; block ID page register in bank 1
                                        (0077)    pSSC_WRITE_FlashBuffer:          equ      FBh   ; pointer to data buffer
                                        (0078)    bSSC_WRITE_PulseWidth:           equ      FCh   ; flash write pulse width or ReadCount
                                        (0079)    bSSC_WRITE_State:                equ      FDh   ; reserved
                                        (0080)    bSSC_WRITE_Delay:                equ      FEh   ; flash macro sequence delay count
                                        (0081)    bSSC_WRITE_ResultCode:           equ      FFh   ; temporary result code
                                        (0082) 
                                        (0083) ;Flash Write Operation Return Code
                                        (0084)    bSSC_WRITE_FAIL:                 equ      00h   ; failure
                                        (0085)    bSSC_WRITE_SUCCESS:              equ      01h   ; pass
                                        (0086) 
                                        (0087) ;Flash Sequence Time Delay
                                        (0088)    bSSC_WRITE_DELAY:                equ      56h   ; 100us delay at 12MHz
                                        (0089) 
                                        (0090) ;Flash Read Operation Template
                                        (0091)    pSSC_READ_FlashBuffer:           equ      FBh   ; pointer to data buffer
                                        (0092)    wSSC_READ_Counter:               equ      FDh   ; byte counter
                                        (0093) 
                                        (0094) ; Table Lookup Template - NOTE that result is a table overlaying reserved area
                                        (0095)    bSSC_TABLE_TableId:              equ      FAh   ; table ID
                                        (0096) 
                                        (0097) ; Temperature Table Template - returned data after performing a
                                        (0098) ;     Table lookup of table #7 - Pulse Width Equation data based on Temperature - y= mt+b
                                        (0099) ;     Composed to two structures - 3 Bytes each - contains slope, y intercept and multiplier
                                        (0100) ;     Structure 1 is for temperatures from [-40,0]C and structure 2 is for temperaturs from [0,40]C.
                                        (0101)    sTEMP_LineEquationBelowZero:     equ      F8h   ; Line Equation data below zero - m,b,Erase->Program multiplier
                                        (0102)    sTEMP_LineEquationAboveZero:     equ      FBh   ; Line Equation data above zero - m,b,Erase->Program multiplier
                                        (0103)    bTEMP_TempTableRevision:         equ      FFh   ; Table Revision number
                                        (0104)    bTEMP_PulseWidthErase:           equ      FEh   ; Temporary storage area after table validation
                                        (0105)    bTEMP_PulseWidthProgram:         equ      FFh   ; Temporary storage area after table validation
                                        (0106)    ;offsets into each substructure
                                        (0107)    cTEMP_SlopeOffset:               equ      0     ; Slope offset in Temp table template
                                        (0108)    cTEMP_InterceptOffset:           equ      1     ; Intercept offset in Temp table template
                                        (0109)    bTEMP_ProgMultOffset:            equ      2     ; Program multiplier
                                        (0110) 
                                        (0111)    VALID_TABLE_REVISION:            equ      1     ; Temp Table revision number
                                        (0112) 
                                        (0113) 
                                        (0114) ; Flash State mode bits - these bits are used to prevent inadvertent jumping into
                                        (0115) ; the flash write API.  If the state does not match then a HALT instruction will
                                        (0116) ; be executed.
                                        (0117) 
                                        (0118)    STATE_SET_CLOCK:                 equ      01h
                                        (0119)    STATE_CALCULATE_PW:              equ      02h
                                        (0120)    STATE_ERASE_BLOCK:               equ      04h
                                        (0121)    STATE_WRITE_BLOCK:               equ      08h
                                        (0122)    STATE_RESTORE_CLOCK:             equ      10h
                                        (0123)    STATE_DONE:                      equ      20h
                                        (0124) 
                                        (0125) ;--------------------------------------------
                                        (0126) ;  Restore area to Code area
                                        (0127) ;--------------------------------------------
                                        (0128) Area BootLoaderArea(ROM,REL)
                                        (0129) // ----------------------------------------------------------------------------------------
                                        (0130) //	Control subroutine which determine whether user program is based on BootLoader Project
                                        (0131) //  Return: 0 - if bad program
                                        (0132) // 	  	    1 - if all right
                                        (0133) // ----------------------------------------------------------------------------------------
                                        (0134) Boot_Is_Program_Good:
                                        (0135) _Boot_Is_Program_Good:
