                                        (0714)    ; mov some args to SSC storage
                                        (0715) 
7F23: 52 03    MOV   A,[X+3]            (0716)    mov   A, [X+pARG_FlashBuffer+1]    ; get pointer - LSB
7F25: 53 FB    MOV   [g_wX10+5],A       (0717)    mov   [pSSC_READ_FlashBuffer],A    ; use SSC storage area
7F27: 52 02    MOV   A,[X+2]            (0718)    mov   A, [X+pARG_FlashBuffer]      ; get pointer - MSB
7F29: 60 D5    MOV   REG[0xD5],A        (0719)    RAM_SETPAGE_MVW A                  ; set the MSB in the MVI Write Pointer
