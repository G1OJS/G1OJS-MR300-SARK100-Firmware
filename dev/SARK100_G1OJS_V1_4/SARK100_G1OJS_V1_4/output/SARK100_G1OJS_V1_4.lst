                                        (0057) ;-----------------------------------------------------------------------------
                                        (0058) ;  FUNCTION NAME: ADCINC12_Start
                                        (0059) ;  FUNCTION NAME: ADCINC12_SetPower
                                        (0060) ;
                                        (0061) ;  DESCRIPTION:
                                        (0062) ;     Applies power setting to the module's analog PSoC block.
                                        (0063) ;
                                        (0064) ;-----------------------------------------------------------------------------
                                        (0065) ;
                                        (0066) ;  ARGUMENTS:
                                        (0067) ;    A  contains the power setting
                                        (0068) ;
                                        (0069) ;  RETURNS: none
                                        (0070) ;
                                        (0071) ;  SIDE EFFECTS:
                                        (0072) ;    The A and X registers may be modified by this or future implementations
                                        (0073) ;    of this function.  The same is true for all RAM page pointer registers in
                                        (0074) ;    the Large Memory Model.  When necessary, it is the calling function's
                                        (0075) ;    responsibility to perserve their values across calls to fastcall16 
                                        (0076) ;    functions.
                                        (0077) ;
                                        (0078)  ADCINC12_Start:
                                        (0079) _ADCINC12_Start:
                                        (0080)  ADCINC12_SetPower:
                                        (0081) _ADCINC12_SetPower:
                                        (0082)    RAM_PROLOGUE RAM_USE_CLASS_2

(0083)    push X                              ;save X
(0084)    mov  X,SP                           ;X will point at next pushed value
(0085)    and  A,03h
(0086)    push A                              ;X points at copy of A
(0087)    mov  A,reg[ADCINC12_AtoDcr3]
(0088)    and  A,~03h                         ;clear power bits
(0089)    or   A,[ X ]
(0090)    mov  reg[ADCINC12_AtoDcr3],A
(0091)    pop  A
(0092)    pop  X
(0093)    RAM_EPILOGUE RAM_USE_CLASS_2
(0094)    ret
                                        (0095) .ENDSECTION
                                        (0096) 
                                        (0097) .SECTION
                                        (0098) ;-----------------------------------------------------------------------------
