(0031) //#include <stdlib.h>
(0032) #include <m8c.h>
(0033) #include "control.h"
(0034) #include "screens.h"
(0035) #include "glb_data.h"
(0036) #include "msg_generic.h"
(0037) #include "storage.h"
(0038) #include "keypad.h"
(0039) #include "morse.h"
(0040) #include "correctionmodel.h"
(0041) #include "pclink.h"
(0042) #include "bridge.h"
(0043) #include "timers.h"
(0044) #include "scans.h"
(0045) #include "derive.h"
(0046) #include "string.h"
(0047) 
(0048) //-----------------------------------------------------------------------------
(0049) //  Defines
(0050) //-----------------------------------------------------------------------------
(0051) 
(0052) 
(0053) //-----------------------------------------------------------------------------
(0054) //  Prototypes
(0055) //-----------------------------------------------------------------------------
(0056) 
(0057) static void Do_Config_Menu (void);
(0058) static void Do_DizzlingMeasureCorrectCalc(void);
(0059) static void Load_Firmware(void);
(0060) static void Config_ByteSettingItem(const char **sSettingStrings, BYTE *bSetting, BYTE bMaxValue);
(0061) static void CycleBand(void);
(0062) static void ChangeCurrHz(STEP_DIRECTION xDir);
(0063) static void cycleParameter(BYTE *bSetting, BYTE bMinValue, BYTE bMaxValue, STEP_DIRECTION xDir, BYTE bCycle);
(0064) static void handleKeypress(BYTE bKey);
(0065) static void PowerSave(void);
(0066) extern void MeasureCorrectCalc(void);
(0067) extern BYTE getUserConfirmation(void);
(0068) extern char FormatNumberRJ(unsigned long dwVal, unsigned char bFieldLen, unsigned char bDP);
(0069) //-----------------------------------------------------------------------------
(0070) //  MAIN
(0071) //-----------------------------------------------------------------------------
(0072) void main(void)
(0073) {
(0074) 	BYTE bKey;
(0075) 
(0076) 	M8C_ClearWDTAndSleep;		
(0077) 	M8C_EnableIntMask(INT_MSK0, INT_MSK0_SLEEP);
(0078) 	M8C_EnableGInt;					
(0079) 	LCD_Start();						// Initialise display
(0080) 	
(0081) 	SetPowerDigitalAndAnalogue(PWRON);
(0082) 	
(0083) 	// Display welcome screen
(0084) 	Screen_CStrAtRowCol(0,0, g_welcome1Str);
(0085) 	Screen_CStrAtRowCol(1,0, g_welcome2Str);
(0086) 	Delay_64ths(TIME_FLASH_MSG);
(0087) 	
(0088) 	//set initial band (scope to store band initial freqs in EEPROM - make g_wBandInitialFreq var not const)
(0089) 	g_bBandIndex = BAND_ATPWRON;
(0090) 	g_dwCurrHz=BAND_FREQ_ToHz * g_wBandInitialFreq[g_bBandIndex];	// current frequency in Hz
(0091) 	
(0092) 	// Check Vf level
(0093) 	if (wRead_ADC_DDSON(VfPort)<500)	{
(0094) 		Morse_Err();
(0095) 		Screen_CStrAtRowCol(0,0, gErrorAdjustVfStr);
(0096) 		Screen_CStrAtRowCol(1,0, gPressAnyKeyStr);
(0097) 		KEYPAD_WaitKey(TIME_WAIT_KEY_S);	// Important, so wait for key press
(0098) 	}
(0099) 
(0100) 	STR_Restore();					// Load cal and config data from EEPROM, with warning message if not calibrated
(0101) 	SetDDSGain();					// it was set at power on but now STR_Restore() has given us a new setting
(0102) 	
(0103) 	// clear screen and start main loop
(0104) 	Screen_Clear();
(0105) 	g_bIdleCounter = g_bUserIdle[g_xConf.bUserIdle];			// Initial set Idle counter
(0106) 	do {
(0107) 		if((g_bMode==MODE_SIG) || (g_bMode==MODE_VFO)) {
(0108) 			Screen_Power(wRead_ADC_DDSUNCHANGED(VzPort));	
(0109) 		} else {
(0110) 			Do_DizzlingMeasureCorrectCalc();
(0111) 			if(g_bMode==MODE_IMP) {Screen_SRXZ();}
(0112) 			else if(g_bMode==MODE_CAP) {Screen_Capacitance();}
(0113) 			else if(g_bMode==MODE_IND) {Screen_Inductance();}
(0114) 		}
(0115) 		if(g_bMode!=MODE_SIG) Screen_Frequency(Display_Hz);							
(0116) 
(0117) 		// wait here until key pressed or measurement timer expires
(0118) 		g_bMeasureCounter = MEASURE_PERIOD;		
(0119) 		do {	
(0120) 			if ((g_bIdleCounter==0) && (g_bUserIdle[g_xConf.bUserIdle] != 0)) PowerSave();
(0121) 			if (g_bMeasureCounter==0) break;	
(0122) 			bKey = KEYPAD_Get();
(0123) 		} while(!bKey);
(0124) 
(0125) 		if (bKey) handleKeypress(bKey);
(0126) 		
(0127) 	} while (TRUE);
(0128) 
(0129) }
(0130) 
(0131) //-----------------------------------------------------------------------------
(0132) //  Main's functions
(0133) //-----------------------------------------------------------------------------
(0134) 
(0135) //-----------------------------------------------------------------------------
(0136) //  FUNCTION NAME:	handleKeypress()
(0137) //  DESCRIPTION:	Function to do actions depending on key pressed
(0138) //  ARGUMENTS:		BYTE bKey - key pressed code
(0139) //  RETURNS: 		Nothing
(0140) //-----------------------------------------------------------------------------
(0141) static void handleKeypress(BYTE bKey){
(0142) 
(0143) 	g_bIdleCounter = g_bUserIdle[g_xConf.bUserIdle];
(0144) 
(0145) 	if(bKey == KBD_CONFIG)  {
(0146) 		if (g_bUP_DOWN_SelectsIncDigit) { g_bUP_DOWN_SelectsIncDigit = 0; }			// Config turns off inc control digit select if it is on
(0147) 		else if (g_bMode == MODE_VFO) 	{ g_bUP_DOWN_SelectsVFOPower = ~g_bUP_DOWN_SelectsVFOPower;}	// If in VFO mode, config key toggles power setting & monitor options
(0148) 		else {Do_Config_Menu();}
(0149) 	}
(0150) 	
(0151) 	if((bKey == KBD_SCAN) && (g_bMode==MODE_IMP)) Do_VSWR_Scan(); 
(0152) 	
(0153) 	if(bKey == KBD_MODE)    {
(0154) 		Screen_Clear();
(0155) 		g_bUP_DOWN_SelectsIncDigit  = FALSE;			// clear the "alt use of arrow keys" flags
(0156) 		g_bUP_DOWN_SelectsVFOPower  = FALSE;
(0157) 		cycleParameter(&g_bMode, 0, MODE_NUM-1, STEPUP, TRUE); 			// cycle to next MODE
(0158) 		if (g_bMode == MODE_VFO) Set_DDS(g_dwCurrHz);		// if going into VFO mode, turn on DDS
(0159) 	}
(0160) 			
(0161) 	if((bKey == KBD_UP_DWN) && (g_bMode != MODE_SIG)) g_bUP_DOWN_SelectsIncDigit = ~g_bUP_DOWN_SelectsIncDigit;    // Toggle between cursor or frequency change modes
(0162) 	if((bKey == KBD_BAND) && (g_bMode != MODE_SIG)) CycleBand(); 
(0163) 
(0164) 	if((bKey==KBD_UP) && (g_bMode != MODE_SIG)){								
(0165) 		if (g_bUP_DOWN_SelectsIncDigit) {cycleParameter(&g_bIncDigit, 0,  NUM_INCREMENT-1, STEPUP, TRUE);} 		// Move frequency cursor left & cycle back to right
(0166) 		else if (g_bUP_DOWN_SelectsVFOPower) { cycleParameter(&g_bDDS_GainStep, 0, GAIN_SETTINGS_NUM-1, STEPUP, FALSE); SetDDSGain();}	// increase DDS level
(0167) 		else ChangeCurrHz(STEPUP); 
(0168) 	}
(0169) 	if((bKey==KBD_DWN) && (g_bMode != MODE_SIG)){								
(0170) 		if (g_bUP_DOWN_SelectsIncDigit) {cycleParameter(&g_bIncDigit, 0, NUM_INCREMENT-1, STEPDOWN, TRUE); }  	// Move frequency cursor right & cycle back to left
(0171) 		else if (g_bUP_DOWN_SelectsVFOPower) {cycleParameter(&g_bDDS_GainStep, 0, GAIN_SETTINGS_NUM-1, STEPDOWN, FALSE); SetDDSGain(); }	// decrease DDS level
(0172) 		else ChangeCurrHz(STEPDOWN); 
(0173) 	}
(0174) 
(0175) 	// speedkeys: if not SIG mode, and UP or DOWN have long press, enter and stay in the loop below until key released
(0176) 	// note - could also use g_bLongPressKeyCounter in place of g_bLongPress (opposite logic) & delete g_bLongPress 
(0177) 	if( ((bKey == KBD_UP) || (bKey == KBD_DWN)) && (g_bLongPress) && (g_bMode != MODE_SIG) && !g_bUP_DOWN_SelectsIncDigit && !g_bUP_DOWN_SelectsVFOPower){ 
(0178) 		Screen_Clear();
(0179) 		while (g_bLongPress && bKey){
(0180) 			bKey = KEYPAD_Get();
(0181) 			if( bKey == KBD_UP	) { ChangeCurrHz(STEPUP);  }
(0182) 			if( bKey == KBD_DWN ) { ChangeCurrHz(STEPDOWN);}
(0183) 		}
(0184) 	}
(0185) 
(0186) }
(0187) //-----------------------------------------------------------------------------
(0188) //  FUNCTION NAME:	PowerSave
(0189) //  DESCRIPTION:  	Turn off / reduce power and wait in 
(0190) //					KEYPAD_SysSuspendAndWakeFromPress until key pressed
(0191) //					then restore power
(0192) //  ARGUMENTS:		none
(0193) //  RETURNS:		Nothing
(0194) //-----------------------------------------------------------------------------
(0195) static void PowerSave(void){
(0196) 	SetPowerDigitalAndAnalogue(PWROFF);
(0197) 	KEYPAD_SysSuspendAndWakeFromPress();
(0198) 	SetPowerDigitalAndAnalogue(PWRON);
(0199) 	g_bIdleCounter = g_bUserIdle[g_xConf.bUserIdle];
(0200) }
(0201) //-----------------------------------------------------------------------------
(0202) //  FUNCTION NAME:	CycleBand
(0203) //  DESCRIPTION:  	Cycle up through bands then back to first band
(0204) //  ARGUMENTS:		none
(0205) //  RETURNS:		Nothing
(0206) //-----------------------------------------------------------------------------
(0207) static void CycleBand(void){
(0208) 	cycleParameter(&g_bBandIndex, 0, BAND_NUM-1, STEPUP, TRUE);
(0209) 	g_dwCurrHz = g_wBandInitialFreq[g_bBandIndex] * BAND_FREQ_ToHz ;
(0210) 	if(!g_bBandIndex) Morse_Dah();
(0211) 	// In VFO mode we don't call Do_DizzlingMeasureCorrectCalc, so we need to set frequency here
(0212) 	if(g_bMode==MODE_VFO) Set_DDS(g_dwCurrHz);
(0213) }
(0214) //-----------------------------------------------------------------------------
(0215) //  FUNCTION NAME:	ChangeCurrHz
(0216) //  DESCRIPTION:  	Change frequency by step g_xIncCtrl[g_bIncDigit].dwInc Hz
(0217) //					Does not move frequency outside current band
(0218) //
(0219) //  ARGUMENTS:		xDir (STEPUP|STEPDOWN)
(0220) //  RETURNS:		Nothing
(0221) //-----------------------------------------------------------------------------
(0222) static void ChangeCurrHz(STEP_DIRECTION xDir){
(0223) 	DWORD dwNewHz = (xDir == STEPUP)? (g_dwCurrHz + g_xIncCtrl[g_bIncDigit].dwInc):(g_dwCurrHz - g_xIncCtrl[g_bIncDigit].dwInc);
(0224) 	if(    (dwNewHz < g_wBandBoundaries[g_bBandIndex] * BAND_FREQ_ToHz ) 
(0225) 		|| (dwNewHz > g_wBandBoundaries[g_bBandIndex+1] * BAND_FREQ_ToHz ) ) return;	
(0226) 	g_dwCurrHz = dwNewHz;
(0227) 	// In VFO mode we don't call Do_DizzlingMeasureCorrectCalc, so we need to set frequency here
(0228) 	if(g_bMode==MODE_VFO) Set_DDS(g_dwCurrHz);
(0229) 	if(g_bLongPress) Screen_Frequency(Display_Hz);	// fast frequency change doesn't pass through frequency display so update that here
(0230) }
(0231) 
(0232) //-----------------------------------------------------------------------------
(0233) //  FUNCTION NAME:	cycleParameter
(0234) //  DESCRIPTION:  	Function to increment or decrement a parameter until it reaches 
(0235) //					its max value or min value. If the parameter hits max||min and 
(0236) //					bCycle is true, the parameter cycles round to min||max
(0237) //  ARGUMENTS:		*bSetting - pointer to the parameter to change
(0238) //					BbMinValue, bMaxValue, xDir (STEPUP|STEPDOWN), bCycle
(0239) //  RETURNS:		Nothing
(0240) //-----------------------------------------------------------------------------
(0241)  
(0242) static void cycleParameter(BYTE *bSetting, BYTE bMinValue, BYTE bMaxValue, STEP_DIRECTION xDir, BYTE bCycle)
(0243) {
(0244) 	if(xDir == STEPDOWN) {
(0245) 		if ((--*bSetting+1) < (bMinValue+1)) *bSetting = (bCycle)? bMaxValue:bMinValue; 
(0246) 	} else {
(0247) 		if (++*bSetting > bMaxValue) *bSetting = (bCycle)? bMinValue:bMaxValue; 
(0248) 	}
(0249) }
(0250) 
(0251) //-----------------------------------------------------------------------------
(0252) //  FUNCTION NAME:	Do_DizzlingMeasureCorrectCalc
(0253) //  DESCRIPTION:  	Briefly step up in frequency & measure reactance, then return
(0254) //					to current frequency and measure again (both measurements also
(0255) //					give full set of VSWR, |Z|, R and X). If reactance increased 
(0256) //					with frequency, set sign of reactance to +ve else -ve, except
(0257) //					if the change is small, leave sign of reactance as it is.
(0258) //  ARGUMENTS:		none
(0259) //  RETURNS:		Nothing
(0260) //-----------------------------------------------------------------------------
(0261) static void Do_DizzlingMeasureCorrectCalc(void)
(0262) {
(0263) 	DWORD dwDizzlingMemoryHz 	= g_dwCurrHz;
(0264) 	WORD wX10_DizzledReactance;
(0265) 	g_dwCurrHz = g_dwCurrHz*(100+DIZZLING_OFFSET_PERCENT) / 100;	// change to dizzled frequency
(0266) 	MeasureCorrectCalc();					// find reactance (incl full set) at dizzling frequency
(0267) 	wX10_DizzledReactance 	= g_wX10;
(0268) 	g_dwCurrHz=dwDizzlingMemoryHz;			// change back to non-dizzled frequency
(0269) 	MeasureCorrectCalc();					// measure full set at non-dizzled frequency
(0270) 	if ( (int)(wX10_DizzledReactance - g_wX10) > 5 || (g_wX10==0) ) 
(0271) 		{g_bSgnX = '+';}
(0272) 	else if ( (int)(g_wX10-wX10_DizzledReactance) > 5) 
(0273) 		{g_bSgnX = '-';}
(0274) }
(0275) 
(0276) //-----------------------------------------------------------------------------
(0277) //  FUNCTION NAME:	Do_Config_Menu
(0278) //  DESCRIPTION: 	Configuration routine
(0279) //  ARGUMENTS: 		none.
(0280) //  RETURNS: 		none.
(0281) //-----------------------------------------------------------------------------
(0282) static void Do_Config_Menu (void)
(0283) {
(0284) 	BYTE bMenu = 0;
(0285) 	BYTE bKey;
(0286) 	DWORD dwSaveHz;
(0287) 
(0288) 	Screen_Clear(); Screen_HideCursor();
(0289) 	
(0290) 	do  {	
(0291) 		Screen_CStrAtRowCol(0, 0, gBlankStr_16);
(0292) 		Screen_CStrAtRowCol(0, 0, gConfigStr[bMenu]);
(0293) 		bKey = KEYPAD_WaitKey(TIME_WAIT_KEY_S);
(0294) 		if (bKey==KBD_UP) 		break;
(0295) 		if (bKey==KBD_CONFIG) 	cycleParameter(&bMenu, 0, CONFIG_NUM-1, STEPUP, TRUE);	
(0296) 		if (bKey==KBD_DWN) {
(0297) 			if (bMenu==CONFIG_PCLINK) 		{ dwSaveHz=g_dwCurrHz; PcLink(); g_dwCurrHz=dwSaveHz; break; }
(0298) 			if (bMenu==CONFIG_Idle) 		{ Config_ByteSettingItem(gIdleStr, &g_xConf.bUserIdle, USER_IDLE_NUM-1); break;}
(0299) 			if (bMenu==CONFIG_FltWt) 		{ Config_ByteSettingItem(gFltWtStr, &g_xConf.bFltWt, FLT_WT_NUM-1); break;}
(0300) 			if (bMenu==CONFIG_CWPitch) 		{ Config_ByteSettingItem(gCWPitchStr, &g_xConf.bCWPitch, CWPitch_NUM-1); break;}
(0301) 			if (bMenu==CONFIG_VF) 			{ Config_ByteSettingItem(gVFStr, &g_xConf.bVF, VF_NUM); break;}
(0302) 			if (bMenu==CONFIG_CALIB) 		{ MeasureUncorrectedRatios();	break;	}	
(0303) 			if (bMenu==CONFIG_SW_LOAD) 		{ Load_Firmware(); break; }
(0304) 		}
(0305) 		if ((bKey==KBD_DWN) || (bKey == KBD_SCAN)) { 
(0306) 			if(bMenu==CONFIG_CableLength)	{ Do_LineLength_Scan(); break;}	
(0307) 		}
(0308) 	} while (TRUE);
(0309) 	
(0310) 	Screen_Clear();
(0311) }
(0312) //-----------------------------------------------------------------------------
(0313) //  FUNCTION NAME:	Config_ByteSettingItem
(0314) //
(0315) //  DESCRIPTION:	On keypress 'config' steps through the values of a parameter
(0316) //					defined by a BYTE setting. At any point, pressing UP cancels 
(0317) //					the operation, pressing down confirms saving the displayed value.
(0318) //  ARGUMENTS:
(0319) //      const char **sSettingStrings, pointer to the array of pointers to the setting 
(0320) //									  strings for the parameter from glb_data.h
(0321) //		BYTE *bSetting,	pointer to the parameter to be set
(0322) //		BYTE bMaxValue, maximum value at which the value returns to zero
(0323) //
(0324) //  RETURNS: none.
(0325) //-----------------------------------------------------------------------------
(0326) static void Config_ByteSettingItem(const char **sSettingStrings, BYTE *bSetting, BYTE bMaxValue)
(0327) {
(0328) 	BYTE bCurrValue = *bSetting;
(0329) 	BYTE bKey;
(0330) 	Screen_CStrAtRowCol(1, 0, sSettingStrings[bCurrValue]);
(0331) 	do {
(0332) 		Screen_CStrAtRowCol(1, 0, sSettingStrings[bCurrValue]);
(0333) 		Screen_CStr(gBlankStr_4);
(0334) 		bKey = KEYPAD_WaitKey(TIME_WAIT_KEY_S);
(0335) 		if (bKey==KBD_CONFIG) 	cycleParameter(&bCurrValue, 0, bMaxValue, STEPUP, TRUE);
(0336) 		if (bKey==KBD_UP) 		break;
(0337) 		if (bKey==KBD_DWN){
(0338) 			*bSetting = bCurrValue;
(0339) 			STR_SaveConfig();
(0340) 			Screen_CStrAtRowCol(1, 8, gValueSavedStr);
(0341) 			Delay_64ths(TIME_FLASH_MSG);
(0342) 			return;
(0343) 		}
(0344) 	} while(TRUE);
(0345) 	
(0346) 	Screen_CStrAtRowCol(1, 0, gNothingChangedStr);
(0347) 	Delay_64ths(TIME_FLASH_MSG);
(0348) }
(0349) 
