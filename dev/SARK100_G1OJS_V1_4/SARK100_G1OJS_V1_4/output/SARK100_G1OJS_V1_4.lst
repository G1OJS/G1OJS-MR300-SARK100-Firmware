(0285) 
(0286) static void FormatNumberRJ_Sliding(unsigned long dwVal, unsigned char bFieldLen, unsigned char bDP)
(0287) {
(0288)    char index;
(0289)    if(bDP==1 && dwVal >=100)  {dwVal = (5 + dwVal)/10; bDP -=1;};
(0290)    if(bDP==2 && dwVal >=1000) {dwVal = (5 + dwVal)/10; bDP -=1;};
(0291)    if(bDP==1 && dwVal >=1000) {dwVal = (5 + dwVal)/10; bDP -=1;};
(0292)    if(!FormatNumberRJ(dwVal, bFieldLen, bDP)) {
(0293)        for(index=0;index<bFieldLen;index++) g_buffer16[index]='*'; 
(0294)    }
(0295) }
