(0170)     push    X                       ; Save the config table address again
(0171)     push    A
(0172)     romx                            ; load config data from the table
(0173)     mov     X, SP                   ; retrieve the register address
(0174)     mov     X, [X-3]
(0175)     mov     reg[X], A               ; Configure the register
(0176)     pop     A                       ; retrieve the table address
(0177)     pop     X
(0178)     inc     X                       ; advance to next table entry
(0179)     adc     A, 0
