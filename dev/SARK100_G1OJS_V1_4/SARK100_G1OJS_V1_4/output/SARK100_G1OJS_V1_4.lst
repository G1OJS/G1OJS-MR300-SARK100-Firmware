7EC8: 52 02    MOV   A,[X+2]            (0619)    mov   A, [X+bTEMP_ProgMultOffset]      ; Mac is signed - First multiply by high 7 bits of ProgMult
7ECA: 67       ASR   A                  (0620)    asr   A                                ; shift high 7 bits down to low 7 bits (divide by 2)
7ECB: 21 7F    AND   A,0x7F             (0621)    and   A, 0x7f                          ; zero out high bit to make it an unsigned divide by 2
