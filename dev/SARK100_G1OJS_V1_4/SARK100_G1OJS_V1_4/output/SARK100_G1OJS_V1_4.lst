(0036) #include "keypad.h"
(0037) 
(0038) #include <m8c.h>        				// Part specific constants and macros
(0039) #include "PSoCAPI.h"    				// PSoC API definitions for all User Modules
(0040) #include "psocgpioint.h"
(0041) #include "glb_data.h"
(0042) #include "morse.h"
(0043) #include "control.h"
(0044) #include "timers.h"
(0045) 
(0046) 
(0047) //-----------------------------------------------------------------------------
(0048) //  FUNCTION NAME:	KEYPAD_Get
(0049) //  DESCRIPTION:	Get key pressed value
(0050) //  ARGUMENTS: 		none.
(0051) //  RETURNS: 		Key pressed. Zero if no key.
(0052) //-----------------------------------------------------------------------------
(0053) BYTE KEYPAD_Get ( void )
(0054) {
(0055) 	BYTE bKey;
(0056) 	static BYTE bLastKey = 0;
(0057) 	BYTE bSpeedAllowed=0;
(0058) 
(0059) 	if (g_bDebounceCounter!=0) return 0;	// in the debounce window, return no press
(0060) 
(0061) 	bKey = KEYPAD_Scan();
(0062) 	if (bKey != KEYPAD_Scan()) bKey = 0;	// error nulling
(0063) 
(0064) 	if (bKey) {
(0065) 		Morse_Dit();
(0066) 		g_bDebounceCounter = KEY_DEBOUNCE_TIME;
(0067) 		if (bKey==bLastKey) {									// Key is held down
(0068) 			if (g_bLongPressKeyCounter == 0) { 					// If counter hits zero, key is held down longer than LONG_PRESS_DET_TIME_S
(0069) 				if((bKey == KBD_UP) || (bKey == KBD_DWN)) {		// Long press for UP/DOWN (and only UP/DOWN) means go fast, so:
(0070) 					g_bDebounceCounter = 0;						// hold debounce counter at zero (this provides the speed increase)
(0071) 					Delay_64ths(SPEED_KEY_CLICKRATE_64ths);		// but introduce a reasonable delay
(0072) 				}
(0073) 				g_bLongPress = 1;								// set global variable to indicate long press
(0074) 			} 	
(0075) 		} else {
(0076) 			g_bLongPressKeyCounter = LONG_PRESS_DET_TIME_S;		// long press counter resets only if key is not held down
(0077) 			bLastKey = bKey;
(0078) 			g_bLongPress = 0; 									// turn off long press flag when key released
(0079) 		}
(0080) 	} else bLastKey = 0;
(0081) 	
(0082) 	
(0083) 	
(0084) 	return bKey;
(0085) }
(0086) 
(0087) //-----------------------------------------------------------------------------
(0088) //  FUNCTION NAME:		KEYPAD_WaitKey
(0089) //  DESCRIPTION:		Waits for key or delay.
(0090) //						Implements power saving features
(0091) //	ARGUMENTS: 			bDelayS	Wait timeout in seconds
(0092) //  RETURNS:			Key pressed.
(0093) //-----------------------------------------------------------------------------
(0094) BYTE KEYPAD_WaitKey ( BYTE bDelayS )
(0095) {
(0096) 	BYTE bKey;
(0097) 										// Actions to minimize power consumption
(0098) 	OSC_CR0 &= ~0x07; 					// Clear Bits 0 to 2
(0099) 	OSC_CR0 |= OSC_CR0_CPU_750kHz; 		// Sets CPU clock to 750Khz
(0100) 	g_bIdleCounter = bDelayS;
(0101) 	do
(0102) 	{
(0103) 		M8C_Sleep;
(0104) 		bKey = KEYPAD_Get();
(0105) 		if (bDelayS)
(0106) 		{
(0107) 			if (g_bIdleCounter==0)
(0108) 				break;
(0109) 		}
(0110) 	} while (bKey == 0);
(0111) 	OSC_CR0 &= ~0x07; 					// Clear Bits 0 to 2
(0112) 	OSC_CR0 |= OSC_CR0_CPU_24MHz;  		// Set CPU Clock to SysClk/1
(0113) 
(0114) 	return bKey;
(0115) }
(0116) 
(0117) //-----------------------------------------------------------------------------
(0118) //  FUNCTION NAME:	KEYPAD_Scan
(0119) //  DESCRIPTION:	Scans keypad
(0120) //  ARGUMENTS:		none.
(0121) //  RETURNS:		Key pressed. Zero if no key.
(0122) //-----------------------------------------------------------------------------
(0123) BYTE KEYPAD_Scan ( void )
(0124) {
(0125) 	BYTE bKey = 0;
(0126) 
(0127) 	COL0_Data_ADDR |= COL0_MASK;
(0128) 	COL1_Data_ADDR |= COL1_MASK;
(0129) 	COL2_Data_ADDR |= COL2_MASK;
(0130) 	
(0131) 	COL1_Data_ADDR &= ~COL1_MASK;
(0132) 	if ( (ROW0_Data_ADDR & ROW0_MASK) == 0 ) bKey = KBD_SCAN;
(0133) 	if ( (ROW1_Data_ADDR & ROW1_MASK) == 0 ) bKey = KBD_UP;
(0134) 	COL1_Data_ADDR |= COL1_MASK;
(0135) 
(0136) 	COL0_Data_ADDR &= ~COL0_MASK;
(0137) 	if ( (ROW0_Data_ADDR & ROW0_MASK) == 0 ) bKey = KBD_CONFIG;
(0138) 	if ( (ROW1_Data_ADDR & ROW1_MASK) == 0 ) bKey = KBD_BAND;
(0139) 	COL0_Data_ADDR |= COL0_MASK;
(0140) 
(0141) 	COL2_Data_ADDR &= ~COL2_MASK;
(0142) 	if ( (ROW0_Data_ADDR & ROW0_MASK) == 0 ) bKey = KBD_MODE;
(0143) 	if ( (ROW1_Data_ADDR & ROW1_MASK) == 0 ) bKey = (bKey==KBD_UP)?   KBD_UP_DWN : KBD_DWN ;
(0144) 	COL2_Data_ADDR |= COL2_MASK;
(0145) 
(0146) 	return bKey;
(0147) }
(0148) 
(0149) //-----------------------------------------------------------------------------
(0150) //  FUNCTION NAME:	KEYPAD_SysSuspendAndWakeFromPress
(0151) //  DESCRIPTION:	System suspend. Wakes up from a key press
(0152) //  ARGUMENTS: 		none.
(0153) //  RETURNS: 		Key pressed. Zero if no key.
(0154) //-----------------------------------------------------------------------------
(0155) void KEYPAD_SysSuspendAndWakeFromPress ( void )
(0156) {
(0157) 	BYTE bSave_ARF_CR;
(0158) 	BYTE bSave_ABF_CR0;
(0159) 	M8C_DisableGInt;
(0160) 	// Activate all columns
(0161) 	COL0_Data_ADDR &= ~COL0_MASK;
(0162) 	COL1_Data_ADDR &= ~COL1_MASK;
(0163) 	COL2_Data_ADDR &= ~COL2_MASK;
(0164) 	// Reduce analog power
(0165) 	bSave_ARF_CR = ARF_CR;
(0166) 	bSave_ABF_CR0 = ABF_CR0;
(0167) 	ARF_CR &= 0xf8; 		// analog blocks Off
(0168) 	ABF_CR0 &= 0xc3;	 	// analog buffer off
(0169) 	// Set low level active interrupt
(0170) 	PRT1IC0	|= 0x3;
(0171) 	PRT1IC1	&= ~0x3;
(0172) 	PRT1IE	|= 0x3;			// Enables row0&row1 interrupt
(0173) 	// Disables sleep interrupt
(0174) 	M8C_DisableIntMask(INT_MSK0, INT_MSK0_SLEEP);
(0175) 	// Enables GPIO interrupt
(0176) 	M8C_EnableIntMask(INT_MSK0, INT_MSK0_GPIO);
(0177) 	INT_CLR0 &= 0x20;		// Clear Pending GPIO Interrupt
(0178) 	M8C_EnableGInt;
(0179) 	M8C_Sleep;				// Goes sleep
(0180) 	INT_VC = 0;							// Erases vector
(0181) 	PRT1IE	&= ~(0x3);		// Disables row0&row1 interrupt					
(0182) 	M8C_DisableIntMask(INT_MSK0, INT_MSK0_GPIO);	// Disables GPIO interrupt			
(0183) 	M8C_EnableIntMask(INT_MSK0, INT_MSK0_SLEEP);	// Restores sleep interrupt
(0184) 	ARF_CR = bSave_ARF_CR;
(0185) 	ABF_CR0 = bSave_ABF_CR0;
(0186) }
