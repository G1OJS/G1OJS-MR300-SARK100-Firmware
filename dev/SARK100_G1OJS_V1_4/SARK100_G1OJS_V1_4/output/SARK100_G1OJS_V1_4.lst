(0066) //  FUNCTION NAME: 	Screen_Frequency
(0067) //  DESCRIPTION:	Display VFO frequency g_dwCurrHz in the current cursor position
(0068) //  ARGUMENTS:		none
(0069) //  RETURNS:		none.
(0070) //-----------------------------------------------------------------------------
(0071) void Screen_Frequency(SCREEN_FREQ_UNITS xDisplayRes)
(0072) {
(0073) 	// display planner ...
(0074) 	// 0123456789012345
(0075) 	//        56295.350
(0076) 
(0077) 	if(xDisplayRes == Display_Hz) FormatNumberRJ(g_dwCurrHz,9,3); else FormatNumberRJ(g_dwCurrHz/1000,5,0);
(0078) 	Screen_StrAtRowCol(0, (xDisplayRes == Display_Hz)? 7:11 , g_buffer16);	
(0079) 	
(0080) 	// show the increment cursor unless in VFO power setting mode or 
(0081) 	// a function calling here without using full Hz resolution (this is a 
(0082) 	// shortcut in the logic & really needs separating into another argument)
(0083) 	if((!g_bUP_DOWN_SelectsVFOPower) && (xDisplayRes==Display_Hz)){
(0084) 		LCD_Position(0, g_xIncCtrl[g_bIncDigit].bCol);  
(0085) 		if (g_bUP_DOWN_SelectsIncDigit) {LCD_Control(LCD_ON_BLINK);} else {LCD_Control(LCD_ON_CURSOR);}
(0086) 	}
(0087) }
