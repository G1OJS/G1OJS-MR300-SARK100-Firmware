                                        (0167) // Flash Block CheckSum
                                        (0168) // Entrance: A - LSB of block ID
                                        (0169) //           X - MSB of block ID 
                                        (0170) // Exit: A - CheckSum
                                        (0171) FlashCheckSum:
                                        (0172) _FlashCheckSum:
