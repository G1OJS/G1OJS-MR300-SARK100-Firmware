(0143)     push    A
(0144)     mov     X, SP
(0145)     mov     [X-4], 0                ; Set default Destination to Bank 0
(0146)     jnc     .BankSelectSaved        ; Carry says Bank 0 is OK
(0147)     mov     [X-4], 1                ; No Carry: default to Bank 1
