(0039) #include "dds.h"
(0040) 
(0041) #include <m8c.h>        				// Part specific constants and macros
(0042) #include "PSoCAPI.h"    				// PSoC API definitions for all User Modules
(0043) #include "psocgpioint.h"
(0044) #include "glb_data.h"
(0045) 
(0046) //-----------------------------------------------------------------------------
(0047) //  Defines
(0048) //-----------------------------------------------------------------------------
(0049) //#define REF_FREQUENCY	(4294967296/180000000)	//30Mhz ref clock times 6
(0050) #define REF_FREQUENCY_NUM	(42949673)			//30Mhz ref clock times 6
(0051) #define REF_FREQUENCY_DEN	(1800000)			//30Mhz ref clock times 6
(0052) 
(0053) //-----------------------------------------------------------------------------
(0054) //  Prototypes
(0055) //-----------------------------------------------------------------------------
(0056) static DWORD divluh1(DWORD x, DWORD y, DWORD z) ;
(0057) static void muldwu1(DWORD w[], DWORD u, DWORD v);
(0058) 
(0059) //-----------------------------------------------------------------------------
(0060) //  FUNCTION NAME:	DDS_Init
(0061) //
(0062) //  DESCRIPTION:
(0063) //
(0064) //	Initializes DDS driver
(0065) //
(0066) //  ARGUMENTS:
(0067) //     none.
(0068) //
(0069) //  RETURNS:
(0070) //     none.
(0071) //
(0072) //-----------------------------------------------------------------------------
(0073) void DDS_Init(void)
(0074) {
(0075) 	DDS_CLK_Data_ADDR &= ~DDS_CLK_MASK;
(0076) 	DDS_DATA_Data_ADDR &= ~DDS_DATA_MASK;
(0077) 	DDS_LOAD_Data_ADDR &= ~DDS_LOAD_MASK;
(0078) 
(0079) 	DDS_CLK_Data_ADDR |= DDS_CLK_MASK;		// Strobe Clock to get hardware bits D0, D1 and D2 into the input reg
(0080) 	DDS_CLK_Data_ADDR &= ~DDS_CLK_MASK;
(0081) 	DDS_LOAD_Data_ADDR |= DDS_LOAD_MASK;	// and raise Load to get them into the bControl reg
(0082) 	DDS_LOAD_Data_ADDR &= ~DDS_LOAD_MASK;
(0083) 
(0084) 	DDS_Set(0);								// Write 32 zeros to AD9851 with 6x PLL enabled
(0085) }
(0086) 
(0087) //-----------------------------------------------------------------------------
(0088) //  FUNCTION NAME:	DDS_Set
(0089) //
(0090) //  DESCRIPTION:
(0091) //
(0092) //	Set DDS frequency
(0093) //
(0094) //  ARGUMENTS:
(0095) //     dwFreqHz	Frequency in Hz
(0096) //
(0097) //  RETURNS:
(0098) //     none.
(0099) //
(0100) //-----------------------------------------------------------------------------
(0101) void DDS_Set(DWORD dwFreqHz)
(0102) {
(0103) 	BYTE bBitCnt;
(0104) 	BYTE bControl;
(0105) 	DWORD dwOp[2];
(0106) 	
(0107) 										// Drop DDS_Load signal to start the programming sequence
(0108) 	DDS_LOAD_Data_ADDR &= ~DDS_LOAD_MASK;
(0109) 
(0110) 										// Transfer frequency bits
(0111) 	if (dwFreqHz!=0)
(0112) 	{									// Needs extended multiply
(0113) 		muldwu1(dwOp, dwFreqHz, REF_FREQUENCY_NUM);
(0114) 		dwFreqHz = divluh1(dwOp[0], dwOp[1], REF_FREQUENCY_DEN);
(0115) 	}
(0116) 
(0117) 	for (bBitCnt=0; bBitCnt<(sizeof(dwFreqHz)*8); bBitCnt++, dwFreqHz>>=1)
(0118) 	{
(0119) 		if ((dwFreqHz&1)!=0)
(0120) 			DDS_DATA_Data_ADDR |= DDS_DATA_MASK;
(0121) 		else
(0122) 			DDS_DATA_Data_ADDR &= ~DDS_DATA_MASK;
(0123) 										// Toggle write clock
(0124) 		DDS_CLK_Data_ADDR |= DDS_CLK_MASK;
(0125) 		DDS_CLK_Data_ADDR &= ~DDS_CLK_MASK;
(0126) 	}
(0127) 
(0128) 										// Transfer bControl word
(0129) 	bControl=0x1;						// 6x PLL enabled, no phase shift
(0130) 	for (bBitCnt=0; bBitCnt<(sizeof(bControl)*8); bBitCnt++, bControl>>=1)
(0131) 	{
(0132) 		if ((bControl&1)!=0)
(0133) 			DDS_DATA_Data_ADDR |= DDS_DATA_MASK;
(0134) 		else
(0135) 			DDS_DATA_Data_ADDR &= ~DDS_DATA_MASK;
(0136) 										// Toggle write clock
(0137) 		DDS_CLK_Data_ADDR |= DDS_CLK_MASK;
(0138) 		DDS_CLK_Data_ADDR &= ~DDS_CLK_MASK;
(0139) 	}
(0140) 										// Raise Load signal to load the DDS registers
(0141) 	DDS_LOAD_Data_ADDR |= DDS_LOAD_MASK;
(0142) 	DDS_LOAD_Data_ADDR &= ~DDS_LOAD_MASK;
(0143) }
(0144) 
(0145) //-----------------------------------------------------------------------------
(0146) //  FUNCTION NAME:	64bit math routines
(0147) //
(0148) //  DESCRIPTION:
(0149) //
(0150) //
(0151) //  ARGUMENTS:
(0152) //     none.
(0153) //
(0154) //  RETURNS:
(0155) //     none.
(0156) //
(0157) //-----------------------------------------------------------------------------
(0158) static DWORD divluh1(DWORD x, DWORD y, DWORD z)
(0159) {
(0160)    										// Divides (x || y) by z.
(0161)    int i;
(0162)    DWORD c;
(0163) 
(0164)    c = 0;
(0165)    for (i = 1; i <= 32; i++)
(0166)    {
(0167)       if (c == 0)
(0168)       {
(0169)          c = x >> 31;
(0170)          x = (x << 1) | (y >> 31); 		// Shift x || y left
(0171)          y = y << 1;               		// one bit.
(0172)          c = c ^ (x < z);
(0173)          x = x - z;
(0174)       }
(0175)       else
(0176)       {
(0177)          c = x >> 31;
(0178)          x = (x << 1) | (y >> 31); 		// Shift x || y left
(0179)          y = y << 1;               		// one bit.
(0180)          x = x + z;
(0181)          c = c ^ (x < z);
(0182)       }
(0183)       y = y + (1 - c);
(0184)    }
(0185)    return y;                    		// Remainder is x.
(0186) }
(0187) 
(0188) static void muldwu1(DWORD w[], DWORD u, DWORD v)
(0189) {
(0190)    DWORD u0, u1, v0, v1, k, t;
(0191)    DWORD w1, w2, w3;
(0192) 
(0193)    u0 = u >> 16; u1 = u & 0xFFFF;
(0194)    v0 = v >> 16; v1 = v & 0xFFFF;
(0195) 
(0196)    t = u1*v1;
(0197)    w3 = t & 0xFFFF;             		// (*)
(0198)    k = t >> 16;
(0199) 
(0200)    t = u0*v1 + k;
(0201)    w2 = t & 0xFFFF;
(0202)    w1 = t >> 16;
(0203) 
(0204)    t = u1*v0 + w2;
(0205)    k = t >> 16;
(0206) 
(0207)    w[0] = u0*v0 + w1 + k;
(0208)    w[1] = (t << 16) + w3;       		// (*)
(0209) /* w[1] = u*v;                  		// Alternative. */
(0210) 
(0211)    return;
(0212) }
(0213) 
