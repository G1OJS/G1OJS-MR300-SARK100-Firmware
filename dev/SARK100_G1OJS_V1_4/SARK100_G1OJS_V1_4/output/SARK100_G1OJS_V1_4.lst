(0032) #include "derive.h"
(0033) #include <m8c.h>        // part specific constants and macros
(0034) #include <math.h>
(0035) #include "PSoCAPI.h"
(0036) #include "psocgpioint.h"
(0037) #include "glb_data.h"
(0038) #include "correctionmodel.h"
(0039) 
(0040) //-----------------------------------------------------------------------------
(0041) //  Prototypes
(0042) //-----------------------------------------------------------------------------
(0043) static WORD max_WORD(WORD a, WORD b);
(0044) static WORD Calc_Sqrt (DWORD dwN);
(0045) 
(0046) //-----------------------------------------------------------------------------
(0047) //  FUNCTION NAME:	max_WORD
(0048) //-----------------------------------------------------------------------------
(0049) static WORD max_WORD(WORD a, WORD b) {
(0050)     return (a > b) ? a : b;
(0051) }
(0052) //-----------------------------------------------------------------------------
(0053) //  FUNCTION NAME:	Do_SZRX_Calcs
(0054) //  DESCRIPTION:    Calculates SWR, |Z|, R and X from bridge ratios
(0055) //					Encoded as SWRx100, |Z|x10, Rx10 and Xx10
(0056) //  FORMULAS:
(0057) //	  SWRx100	= 100 * (1000 + g_wBrgRts[MODGAMMA])/(1000 - g_wBrgRts[MODGAMMA])
(0058) //
(0059) //	  Zx10		=	10*50*g_wBrgRts[MODZ]/1000 		= 	g_wBrgRts[MODZ]/2
(0060) //
(0061) //                 	(2500 + Z^2) * SWR			(250000 + (Zx10)^2) 
(0062) //    Rx10 		= 	------------------		=  	-------------------------------
(0063) //               	5 * (SWR^2 + 1)				5*(SWRx100)  +  50000/(SWRx100)
(0064) //
(0065) //    Xx10 		= 	SQRT ( (Z*10)^2 - (R*10)^2 )
(0066) //
(0067) //  ARGUMENTS:  None
(0068) //  RETURNS: 	Nothing
(0069) //
(0070) //-----------------------------------------------------------------------------
(0071) void Do_SZRX_Calcs (void)
(0072) {
(0073) 	DWORD dwDenominator;
(0074) 	DWORD dwNumerator;
(0075) 
(0076) 	// Get SWRx100 from g_wBrgRts[MODGAMMA] which encodes Vr/Vf = 1 as 1000 
(0077) 	dwNumerator = wUNITY + g_wBrgRts[MODGAMMA]; 
(0078) 	dwDenominator = wUNITY - g_wBrgRts[MODGAMMA];
(0079) 	g_wSwr100 = (WORD)((DWORD)100*dwNumerator/dwDenominator);
(0080) 	
(0081) 	// Get |Z|x10 from g_wBrgRts[MODZ] which encodes 1 as 1000 so 500*Vz/Va is 500*g_wBrgRts[MODZ]/1000 = g_wBrgRts[MODZ]/2
(0082) 	// hence g_wZ10 can't exceed 32767 after correction (20480 before correction since g_wBrgRts[MODZ] uncorrected can't exceed 4096)
(0083) 	// but can range in theory from 0 to 
(0084) 	g_wZ10 = g_wBrgRts[MODZ]/2;
(0085) 	
(0086) 	// if SWR is lower than either 50/|Z| or |Z|/50, this will lead to R > |Z| and possible overflows
(0087) 	// g_wSwr100 won't arrive here higher than 49900 (|Z|=24950 ohms or 0.1 ohms)
(0088) 	// this equates to g_wZ10 = at least 2. g_wZ10=32767 equates to g_wSwr100=6553 which is less than max allowable SWR
(0089) 	// so enforcing g_wZ10 >=2 allows enforcing the SWR >= max(50/|Z|,|Z|/50) without causing SWR>499
(0090) 	// SWR>=|Z|/50 equates to g_wSwr100>=g_wZ10/5, and SWR>=50/|Z| equates to g_wSwr100>=50000/g_wZ10, 
(0091) 	g_wZ10 = max_WORD(g_wZ10,2);	
(0092) 	g_wSwr100=max_WORD(g_wSwr100, 1 + 50000 / g_wZ10);
(0093) 	g_wSwr100=max_WORD(g_wSwr100, 1 + g_wZ10/5);
(0094) 		
(0095) 	// Get R from |Z| and SWRx100
(0096) 	dwNumerator 	= 250000+ (DWORD)g_wZ10*g_wZ10;			// DWORD safe to >~ 6000 ohms 
(0097) 	dwDenominator 	= 5*g_wSwr100 + 50000/g_wSwr100;		// safe for any real-life VSWR
(0098)    	g_wR10 = dwNumerator/dwDenominator;	
(0099) 		
(0100) 	// Get X from R and |Z| (reusing dwNumerator)
(0101) 	dwNumerator = (DWORD)g_wZ10*(DWORD)g_wZ10 - (DWORD)g_wR10*(DWORD)g_wR10; // DWORD safe to >~ 5000 ohms 
(0102) 	g_wX10 = Calc_Sqrt(dwNumerator);
(0103) }
(0104) //-----------------------------------------------------------------------------
(0105) //  FUNCTION NAME:	Calc_Sqrt
(0106) //  DESCRIPTION:	Calculates square root for integer number
(0107) //  ARGUMENTS:		DWORD dwN	Radicand
(0108) //  RETURNS:		(WORD) 		Square root
(0109) //-----------------------------------------------------------------------------
(0110) static WORD Calc_Sqrt (DWORD dwN)
(0111) {
(0112) 	DWORD dwRem = 0;
(0113) 	DWORD dwRoot = 0;
(0114) 	BYTE ii;
(0115) 	
(0116) 	if (dwN > 4294836225) { // Maximum DWORD value where sqrt fits in a WORD
(0117)     	return WORD_MAX; 	// Return maximum value for WORD
(0118) 	}
(0119) 
(0120) 	for (ii=0;ii<16;ii++)
(0121) 	{
(0122) 		dwRoot <<= 1;
(0123) 		dwRem = ((dwRem<<2)+(dwN>>30));
(0124) 		dwN <<= 2;
(0125) 		dwRoot++;
(0126) 		if (dwRoot<=dwRem) {
(0127) 			dwRem -= dwRoot;
(0128) 			dwRoot++; 
(0129) 		} else {
(0130) 			dwRoot--;
(0131) 		}
(0132) 	}
(0133) 	return (WORD)(dwRoot>>1);
(0134) }
(0135) 
(0136) 
