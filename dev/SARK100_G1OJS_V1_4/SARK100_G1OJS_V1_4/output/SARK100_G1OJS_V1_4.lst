(0038) //-----------------------------------------------------------------------------
(0039) //  FUNCTION NAME: 	SleepTimerINT
(0040) //  DESCRIPTION:	Sleep timer interrupt sevice routine. Period 64Hz.
(0041) //  ARGUMENTS:		none.
(0042) //  RETURNS: 		none.
(0043) //-----------------------------------------------------------------------------
(0044) 
(0045) static volatile BYTE gDivider_1 = 1;	// Counter to divide clock by 8
(0046) static volatile BYTE gDivider_2 = 1;	// Counter to divide clock by 8
(0047) #pragma interrupt_handler 	SleepTimerINT
(0048) void SleepTimerINT ( void )
(0049) {
(0050) 	M8C_ClearWDTAndSleep;
(0051) 	
(0052) 	if (g_bSixtyFourthSecondCounter) 	g_bSixtyFourthSecondCounter--;
(0053) 	
(0054) 	if( --gDivider_1 ) return;	// only pass here to decrement once per sixteenth second counters
(0055) 		gDivider_1 = 4; 
(0056) 		if (g_bMeasureCounter) 			g_bMeasureCounter--;
(0057) 		if (g_bDebounceCounter) 		g_bDebounceCounter--;
(0058) 		
(0059) 	if( --gDivider_2 ) return;	// only pass here to decrement once per second counters
(0060) 		gDivider_2 = 16; 		
(0061) 		if (g_bLongPressKeyCounter) 		g_bLongPressKeyCounter-- ;
(0062) 		if (g_bIdleCounter)    			g_bIdleCounter-- ;
(0063) }
(0064) //-----------------------------------------------------------------------------
(0065) //  FUNCTION NAME: 	Delay_64ths
(0066) //  DESCRIPTION: 	Implements a blocking delay of b64ths/64 seconds
(0067) //  ARGUMENTS:  	BYTE b64ths: 1= 16ms, 255= 3984ms
(0068) //  RETURNS:  		Nothing
(0069) //-----------------------------------------------------------------------------
(0070) void Delay_64ths(BYTE b64ths)			
(0071) {
(0072) 	g_bSixtyFourthSecondCounter = b64ths;
(0073) 	M8C_Sleep;
(0074) 	while(1){ if (g_bSixtyFourthSecondCounter ==0) break; }
(0075) }
(0076) 
