(0156)     push    A
(0157)     romx                            ; Load register address from table
(0158)     cmp     A, END_CONFIG_TABLE     ; End of table?
(0159)     jz      EndLoadConfig           ;   Yes, go wrap it up
(0160)     mov     X, SP                   ;
(0161)     tst     [X-4], 1                ; Loading IO Bank 1?
(0162)     jz      .IOBankNowSet           ;    No, Bank 0 is fine
(0163)     M8C_SetBank1                    ;   Yes, switch to Bank 1
                                        (0164) .IOBankNowSet:
(0165)     mov     [X-3], A                ; Stash the register address
(0166)     pop     A                       ; Retrieve the table address
(0167)     pop     X
(0168)     inc     X                       ; Advance to the data byte
