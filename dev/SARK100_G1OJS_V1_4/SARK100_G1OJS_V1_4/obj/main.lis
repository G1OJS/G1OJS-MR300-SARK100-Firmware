 0AE7           ; //  FUNCTION NAME:    FormatNumberRJ
 0AE7           ; //  DESCRIPTION:      Bespoke ultoa eliminates library calls & saves 700 bytes ROM
 0AE7           ; //                  Results are right-justified if bFieldLen > len needed.
 0AE7           ; //  ARGUMENTS:                dwVal           - number to convert
 0AE7           ; //                                    bFieldLen       - number of digits (including the decimal point)
 0AE7           ; //                                beyond which **** is the result
 0AE7           ; //                                    bDP                     - number of decimal places
 0AE7           ; //                              - FIXED - fixes the number of decimal places
 0AE7           ; //  RETURNS:          true        - OK
