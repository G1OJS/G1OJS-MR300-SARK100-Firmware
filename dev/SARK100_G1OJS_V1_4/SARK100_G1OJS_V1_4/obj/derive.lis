 0033           ; //  FUNCTION NAME:    Do_SZRX_Calcs
 0033           ; //  DESCRIPTION:    Calculates SWR, |Z|, R and X from bridge ratios
 0033           ; //                                    Encoded as SWRx100, |Z|x10, Rx10 and Xx10
 0033           ; //  FORMULAS:
 0033           ; //      SWRx100       = 100 * (1000 + g_wBrgRts[MODGAMMA])/(1000 - g_wBrgRts[MODGAMMA])
 0033           ; //
 0033           ; //      Zx10          =       10*50*g_wBrgRts[MODZ]/1000              =       g_wBrgRts[MODZ]/2
 0033           ; //
 0033           ; //                    (2500 + Z^2) * SWR                      (250000 + (Zx10)^2) 
 0033           ; //    Rx10            =       ------------------              =       -------------------------------
 0033           ; //                    5 * (SWR^2 + 1)                         5*(SWRx100)  +  50000/(SWRx100)
 0033           ; //
 0033           ; //    Xx10            =       SQRT ( (Z*10)^2 - (R*10)^2 )
 0033           ; //
 0033           ; //  ARGUMENTS:  None
 0033           ; //  RETURNS:  Nothing
 0033           ; //
 0033           ; //-----------------------------------------------------------------------------
