 00AB           ; //  FUNCTION NAME:    pcLinkPrintToSerial
 00AB           ; //  DESCRIPTION:      Print out all four bridge voltages and/or SWR,R,X,Z
 00AB           ; //                                    depending on PRINT_WHAT
 00AB           ; //                                    NOTE that individual voltages are no longer used in the bulk
 00AB           ; //                                    of the calculations (converted to ratios just after measurement)
 00AB           ; //                                    but 4 values need to be provided for compatibility with 
 00AB           ; //                                    companion software that expects them via Cmd_Raw
 00AB           ; //                                    Hence, measure Vf and Vr again (uncorrected) and print out
 00AB           ; //                                    Vf_uncorrected, Vf_uncorrected x (Vr/Vf)_corrected, 
 00AB           ; //                                    Va_uncorrected x (Vz/Va)_corrected, Va_uncorrected
 00AB           ; //  ARGUMENTS:                MEASMODE = CMD | SCANNING
 00AB           ; //                                            CMD - called directly from pclink, likely 3rd party software
 00AB           ; //                                            SCANNING - called from pcLinkFreqScan & using averaging
 00AB           ; //                                    PRINT_WHAT = VRVFVZVA | SRXZ | COMBI
 00AB           ; //
 00AB           ; //    RETURNS:         
 00AB           ; //
 00AB           ; //    - if PRINT_WHAT == VRVFVZVA             (this emulates the old Cmd_Raw)
 00AB           ; //            Response: corrected voltages  Vf, 'Vr' = (Vr/Vf)*Vf, 
 00AB           ; //                                                                      'Vz'     = (Vz/Va)*Va, Va
 00AB           ; //
 00AB           ; //    Example: 4000000,165000,31800,1000000 
 00AB           ; //
 00AB           ; //    - if PRINT_WHAT == SRXZ                 (this emulates the old Cmd_Imp)
 00AB           ; //            Response: corrected parameters {SWR},{R},{X},{Z}
 00AB           ; //    Example: 1.05,52,10,51 
 00AB           ; //
 00AB           ; //  NOTE: used by some third party software. The expected format is as the example above
 00AB           ; //-----------------------------------------------------------------------------
 00AB           ; 
