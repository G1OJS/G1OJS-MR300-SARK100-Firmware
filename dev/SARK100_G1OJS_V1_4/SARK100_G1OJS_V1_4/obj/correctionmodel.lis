 0004           ; //
 0004           ; //    PROJECT:        SARK100 SWR Analyzer
 0004           ; //    FILE NAME:      correctionmodel.c
 0004           ; //    AUTHOR:         Alan Robinson
 0004           ; //
 0004           ; //    DESCRIPTION: Characterises the bridge by recording the measured bridge ratios
 0004           ; //                             across frequency for a set of known loads. Encodes the characterisation
 0004           ; //                             data using a Moebius Transform for compact storage. Decodes the 
 0004           ; //                             characterisation data and corrects measurements.
 0004           ; //
 0004           ; //    HISTORY
 0004           ; //    NAME    DATE            REMARKS
 0004           ; //    AJR             JAN 2025        Creation
 0004           ; //*****************************************************************************/
